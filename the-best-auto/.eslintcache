e: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/categories/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/theme.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/proposition/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/slider/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/filter-select/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-au