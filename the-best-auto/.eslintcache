ex.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/youtube/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],["266","267"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/home/index.tsx",["268"],"import { useTheme } from '@material-ui/core/styles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport { Section } from 'shared/atoms'\nimport { TitleWithIcon } from 'shared/molecules'\nimport { ServicesGrid, ServicesGridItem } from 'features/services/atoms'\nimport { ServicesCard } from 'features/services/molecules'\nimport Box from '@material-ui/core/Box'\nimport Typography from '@material-ui/core/Typography'\nimport Divider from '@material-ui/core/Divider'\nimport VpnKeyTwoToneIcon from '@material-ui/icons/VpnKeyTwoTone'\nimport BusinessCenterIcon from '@material-ui/icons/BusinessCenter'\nimport DriveEtaIcon from '@material-ui/icons/DriveEta'\nimport InsertDriveFileIcon from '@material-ui/icons/InsertDriveFile'\nimport PaymentIcon from '@material-ui/icons/Payment'\nimport LocalShippingIcon from '@material-ui/icons/LocalShipping'\nimport VerifiedUserIcon from '@material-ui/icons/VerifiedUser'\nimport BuildIcon from '@material-ui/icons/Build'\nimport InstagramIcon from '@material-ui/icons/Instagram'\nimport YouTubeIcon from '@material-ui/icons/YouTube'\nimport { Social } from 'features/social-media/organisms'\nimport GroupIcon from '@material-ui/icons/Group'\n\nexport const HomePage = () => {\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.down('md'))\n  return (\n    <>\n      <Section>\n        <Box textAlign='center'>\n          <Box fontSize={50} lineHeight={0}>\n            <VpnKeyTwoToneIcon fontSize='inherit' color='secondary' />\n          </Box>\n          <Typography variant={matches ? 'h3' : 'h2'}>АВТО З АМЕРИКИ, ЄВРОПИ, КАНАДИ</Typography>\n          <Typography color='secondary' variant={matches ? 'h3' : 'h2'}>\n            ПІД КЛЮЧ\n          </Typography>\n        </Box>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={<BusinessCenterIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАШІ'\n          secondaryText='ПОСЛУГИ'\n        />\n        <ServicesGrid>\n          <ServicesGridItem>\n            <ServicesCard icon={<DriveEtaIcon fontSize='inherit' />} text='ПІДБІР АВТОМОБІЛЯ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<InsertDriveFileIcon fontSize='inherit' />} text='ПЕРЕВІРКА ДОКУМЕНТІВ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<PaymentIcon fontSize='inherit' />} text='ПОКУПКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<LocalShippingIcon fontSize='inherit' />} text='ДОСТАВКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard\n              icon={<VerifiedUserIcon fontSize='inherit' />}\n              text='РОЗМИТНЕННЯ, СЕРТИФІКАЦІЯ, ПОСТАНОВКА НА ОБЛІК'\n            />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<BuildIcon fontSize='inherit' />} text='ДОПОМОГА З РЕМОНТОМ' />\n          </ServicesGridItem>\n        </ServicesGrid>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={\n            <>\n              <InstagramIcon fontSize='inherit' color='secondary' />\n              <YouTubeIcon fontSize='inherit' color='secondary' />\n            </>\n          }\n          primaryText='МИ В'\n          secondaryText='СОЦМЕРЕЖАХ'\n        />\n        <Social />\n      </Section>\n\n      <Divider />\n      {/* <Section>\n        <TitleWithIcon\n          icon={<GroupIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАША'\n          secondaryText='КОМАНДА'\n        />\n      </Section> */}\n    </>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/loading-error/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/category-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/categories/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/theme.ts",[],["269","270"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/proposition/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/index.ts",[],["271","272"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/slider/index.tsx",["273"],"import { memo, useState } from 'react'\nimport { useAppDispatch } from 'configureStore'\nimport Grid from '@material-ui/core/Grid'\nimport TextField from '@material-ui/core/TextField'\nimport Slider from '@material-ui/core/Slider'\n\ninterface FilterSliderProps {\n  min: number\n  max: number\n  onChange: ((event: React.ChangeEvent<{}>, value: number | number[]) => void) | undefined\n  onChangeCommitedAction: (payload: number | number[]) => any\n  value: number[]\n}\n\nexport const FilterSlider = memo(({ min, max, onChangeCommitedAction, onChange, value }: FilterSliderProps) => {\n  const dispatch = useAppDispatch()\n  const onChangeCommited = (event: any, newValue: number | number[]) => {\n    dispatch(onChangeCommitedAction(newValue as number[]))\n  }\n  return (\n    <Grid container spacing={1}>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? min : value[0]} fullWidth type='number' label='від' />\n      </Grid>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? max : value[1]} fullWidth type='number' label='до' />\n      </Grid>\n      <Grid item xs={12} md={12}>\n        <Slider\n          onChangeCommitted={onChangeCommited}\n          min={min}\n          max={max}\n          onChange={onChange}\n          value={value[1] === 0 ? [min, max] : value}\n          color='secondary'\n          valueLabelDisplay='auto'\n          aria-labelledby='range-slider'\n        />\n      </Grid>\n    </Grid>\n  )\n})\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],["274","275"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/filter-select/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",["276","277"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/add/index.tsx",["278"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/add/slice.tsx",[],{"ruleId":"279","replacedBy":"280"},{"ruleId":"281","replacedBy":"282"},{"ruleId":"279","replacedBy":"283"},{"ruleId":"281","replacedBy":"284"},{"ruleId":"279","replacedBy":"285"},{"ruleId":"281","replacedBy":"286"},{"ruleId":"279","replacedBy":"287"},{"ruleId":"281","replacedBy":"288"},{"ruleId":"279","replacedBy":"289"},{"ruleId":"281","replacedBy":"290"},{"ruleId":"279","replacedBy":"291"},{"ruleId":"281","replacedBy":"292"},{"ruleId":"279","replacedBy":"293"},{"ruleId":"281","replacedBy":"294"},{"ruleId":"295","severity":1,"message":"296","line":21,"column":8,"nodeType":"297","messageId":"298","endLi