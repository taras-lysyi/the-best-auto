49"},{"filePath":"278","messages":"279","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"280","messages":"281","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"282","messages":"283","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"284","messages":"285","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"286","messages":"287","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"288","messages":"289","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"290","messages":"291","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"292","messages":"293","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"168"},{"filePath":"294","messages":"295","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"163"},{"filePath":"296","messages":"297","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"163"},{"filePath":"298","messages":"299","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"163"},"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],["300","301"],"/home/taras/dev/the-best-auto/the-best-auto/src/configureStore.ts",[],["302","303"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",["304"],"import axios from 'axios'\nimport { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit'\nimport { LoadingStatusT } from 'shared/types'\n\ninterface GetCategoriesResponseI {\n  category_id: number\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n\n  active: number\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\n\nexport const getCategories = createAsyncThunk('/category/all', async () => {\n  const response = await axios.post('/category/all')\n  return response.data.result\n})\n\ninterface GetCategoriesStructureResponseI {\n  category_id: number\n  breadcrumb: {\n    title: string\n    link: string\n\n    parent: null | number\n  }\n  child: []\n  childIds: number[]\n  parent: []\n  parentIds: number[]\n\n  linkGo: string\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n  active: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n",["305","306"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],["307","308"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],["309","310"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/add/index.tsx",["311","312"],"import { useEffect } from 'react'\nimport { makeStyles, Theme, createStyles } from '@material-ui/core/styles'\nimport { useTypedSelector, useAppDispatch } from 'configureStore'\nimport { selectFormDataIsInitialized } from 'features/crm/features/catalog/selectors'\nimport { getCategories } from 'features/catalog/features/categories/slice'\nimport { selectCategoriesData } from 'features/catalog/features/categories/selectors'\nimport { getBrands, getFeatures, getFeaturesValue } from 'features/catalog/features/filter/slice'\nimport { selectBrands, selectSortedFeaturesWithValues } from 'features/catalog/features/filter/selectors'\nimport { setFormDataIsInitialized, FormDataI, addCRM } from 'features/crm/features/catalog/slice'\nimport Typography from '@material-ui/core/Typography'\nimport Box from '@material-ui/core/Box'\nimport Button from '@material-ui/core/Button'\nimport AddIcon from '@material-ui/icons/Add'\nimport Select from '@material-ui/core/Select'\nimport InputLabel from '@material-ui/core/InputLabel'\nimport FormControl from '@material-ui/core/FormControl'\nimport MenuItem from '@material-ui/core/MenuItem'\nimport FormHelperText from '@material-ui/core/FormHelperText'\nimport TextField from '@material-ui/core/TextField'\nimport Checkbox from '@material-ui/core/Checkbox'\nimport FormControlLabel from '@material-ui/core/FormControlLabel'\nimport Chip from '@material-ui/core/Chip'\nimport Input from '@material-ui/core/Input'\nimport ListItemText from '@material-ui/core/ListItemText'\nimport { useForm, Controller } from 'react-hook-form'\n\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    icon: {\n      cursor: 'pointer',\n      '&:hover': {\n        backgroundColor: theme.palette.secondary.main,\n      },\n    },\n    formControl: {\n      margin: theme.spacing(1),\n      minWidth: 200,\n    },\n    chips: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      maxWidth: 900,\n    },\n    chip: {\n      margin: 2,\n    },\n  }),\n)\nconst ITEM_HEIGHT = 48\nconst ITEM_PADDING_TOP = 8\nconst MenuProps = {\n  PaperProps: {\n    style: {\n      maxHeight: ITEM_HEIGHT * 4.5 + ITEM_PADDING_TOP,\n      width: 250,\n    },\n  },\n}\n\ninterface Inputs {\n  itemId: null | number\n  dateActive: null\n  timeActive: null\n  title: string\n  images: string[]\n  categoryId: null | number\n  brandId: null | number\n  productCode: string\n  vin: string\n  mileage: number\n  ml: 0 | 1\n  year: string\n  price: number\n  offerPrice: null | number\n  available: 0 | 1\n  description: string\n  note: string\n  popular: 0 | 1\n  new: 0 | 1\n  sale: 0 | 1\n  sold: 0 | 1\n  active: 0 | 1\n  features: [\n    {\n      featureId: number\n      featureValueId: number\n      featureValue: string\n    },\n  ][]\n  variant: []\n}\n\nexport const Add = () => {\n  const dispatch = useAppDispatch()\n  const formDataInitialized = useTypedSelector(state => selectFormDataIsInitialized(state))\n  const categories = useTypedSelector(state => selectCategoriesData(state))\n  const featuresWithValues = useTypedSelector(state => selectSortedFeaturesWithValues(state))\n  const brands = useTypedSelector(state => selectBrands(state))\n  function generateArrayOfYears() {\n    var max = new Date().getFullYear()\n    var min = max - 70\n    var years = []\n\n    for (var i = max; i >= min; i--) {\n      years.push(i)\n    }\n    return years\n  }\n  const years = generateArrayOfYears()\n  useEffect(() => {\n    if (!formDataInitialized) {\n      Promise.all([\n        dispatch(getCategories()),\n        dispatch(getBrands()),\n        dispatch(getFeatures()),\n        dispatch(getFeaturesValue()),\n        dispatch(setFormDataIsInitialized({ value: true })),\n      ])\n    }\n  }, [formDataInitialized, categories, featuresWithValues, dispatch])\n  const { handleSubmit, errors, control } = useForm<Inputs>({\n    defaultValues: {\n      itemId: null,\n      dateActive: null,\n      timeActive: null,\n      title: '',\n      images: [],\n      categoryId: null,\n      brandId: null,\n      productCode: '',\n      vin: '',\n      mileage: 0,\n      ml: 0,\n      year: '',\n      price: 0,\n      offerPrice: null,\n      available: 0,\n      description: '',\n      note: '',\n      popular: 0,\n      new: 0,\n      sale: 0,\n      sold: 0,\n      active: 0,\n      features: [],\n      variant: [],\n    },\n  })\n  const onSubmit = (data: Inputs) => {\n    data.images = []\n    data.itemId = null\n    data.productCode = '0'\n    data.timeActive = null\n    data.dateActive = null\n    data.variant = []\n    data.active = 0\n    data.available = 0\n    data.sold = 0\n    const sortedFeatures: {\n      featureId: number\n      featureValueId: number\n      featureValue?: string\n    }[] = []\n    data.features.forEach(item => {\n      sortedFeatures.push(...item)\n      sortedFeatures.forEach(item => {\n        delete item.featureValue\n      })\n    })\n\n    const bodyData: FormDataI = Object.assign(data)\n    bodyData.features = sortedFeatures\n    dispatch(addCRM(bodyData)).then(result => {\n      if (result.meta.requestStatus === 'fulfilled') {\n        window.location.href = `/crm/catalog/edit/${result.payload.item_id}`\n      }\n    })\n  }\n  const classes = useStyles()\n\n  const handleChange = ([event]: any) => {\n    return event.target.value\n  }\n\n  return (\n    <Box textAlign='center'>\n      <form onSubmit={handleSubmit(onSubmit)}>\n        <FormControl className={classes.formControl} error={Boolean(errors.categoryId)}>\n          <InputLabel id='category-select-label'>Категорiя</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {categories.map(category => {\n                  return <MenuItem value={category.category_id}>{category.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='categoryId'\n            rules={{ required: `Категорiя обов'язкова!` }}\n            control={control}\n          />\n          <FormHelperText>{errors.categoryId && errors.categoryId.message}</FormHelperText>\n        </FormControl>\n\n        <FormControl className={classes.formControl} error={Boolean(errors.title)}>\n          <Controller\n            error={Boolean(errors.title)}\n            as={TextField}\n            rules={{ required: `Назва обов'язкова!` }}\n            name='title'\n            label='Повна назва'\n            control={control}\n          />\n          <FormHelperText>{errors.title && errors.title.message}</FormHelperText>\n        </FormControl>\n        <FormControl\n          className={classes.formControl}\n          // error={Boolean(errors.brandId)}\n        >\n          <InputLabel id='brand-select-label'>Марка</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {brands.map(brand => {\n                  return <MenuItem value={brand.brand_id}>{brand.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='brandId'\n            // rules={{ required: `Марка обов'язкова!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.brandId && errors.brandId.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller as={TextField} name='vin' label='VIN номер' control={control} defaultValue='' />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.price)}>\n          <Controller\n            error={Boolean(errors.price)}\n            type='number'\n            rules={{ required: `Актуальна цiна обо'язкова` }}\n            as={TextField}\n            name='price'\n            label='Актуальна цiна ($)'\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.price && errors.price.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            type='number'\n            name='offerPrice'\n            label='Стара цiна ($)'\n            control={control}\n            defaultValue={null}\n          />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.mileage)}>\n          <Controller\n            name='ml'\n            defaultValue={0}\n            control={control}\n            render={props => (\n              <FormControlLabel\n                label='Пробiг в милях'\n                control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n              />\n            )}\n          />\n          <Controller\n            rules={{ required: `Пробiг обов'язковий!` }}\n            as={TextField}\n            name='mileage'\n            value\n            label='Пробiг'\n            control={control}\n            type='number'\n            defaultValue={0}\n          />\n          <FormHelperText>{errors.mileage && errors.mileage.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.year)}>\n          <InputLabel id='year-select-label'>Рiк випуску</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {years.map(year => {\n                  return <MenuItem value={String(year)}>{year}</MenuItem>\n                })}\n              </Select>\n            }\n            name='year'\n            rules={{ required: `Рiк обов'язковий!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.year && errors.year.message}</FormHelperText>\n        </FormControl>\n        <br />\n        <Controller\n          name='popular'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Топ пропозицiя'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='new'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Новинка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='sale'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Знижка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        {/*\n                <Typography variant='h5'>Характеристика</Typography>\n                <Button variant='contained' color='primary' size='large' endIcon={<AddIcon />}>\n                  Додати характеристику\n                </Button>\n                */}\n        <br />\n        {featuresWithValues.map(featureWithValues => {\n          return (\n            <FormControl className={classes.formControl} key={featureWithValues.feature.feature_id}>\n              <InputLabel id={`feature-${featureWithValues.feature.feature_id}`}>\n                {featureWithValues.feature.feature_name}\n              </InputLabel>\n              <Controller\n                as={\n                  featureWithValues.feature.feature_id >= 10 ? (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      multiple\n                      input={<Input />}\n                      renderValue={selected => (\n                        <div className={classes.chips}>\n                          {(selected as {\n                            featureId: number\n                            featureValueId: number\n                            featureValue: string\n                          }[])\n                            .filter(item => {\n                              return featureWithValues.feature.feature_id === item.featureId\n                            })\n                            .map(value => {\n                              return (\n                                <Chip key={value.featureValueId} label={value.featureValue} className={classes.chip} />\n                              )\n                            })}\n                        </div>\n                      )}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = {\n                          featureId: featureWithValues.feature.feature_id,\n                          featureValueId: featureValueItem.feature_value_id,\n                          featureValue: featureValueItem.feature_value,\n                        }\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  ) : (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      input={<Input />}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = [\n                          {\n                            featureId: featureWithValues.feature.feature_id,\n                            featureValueId: featureValueItem.feature_value_id,\n                            featureValue: featureValueItem.feature_value,\n                          },\n                        ]\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  )\n                }\n                name={`features[${featureWithValues.feature.feature_id}]`}\n                control={control}\n                defaultValue={[]}\n                onChange={handleChange}\n              />\n            </FormControl>\n          )\n        })}\n        <br />\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='description'\n            control={control}\n            variant='outlined'\n            label={`Опис`}\n            multiline\n            rows={4}\n            placeholder='Введiть опис'\n          />\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='note'\n            control={control}\n            variant='outlined'\n            label={`Примiтка (не відображається)`}\n            multiline\n            rows={4}\n            placeholder='Введiть примiтку'\n          />\n        </FormControl>\n        <br />\n        <Button type='submit' color='secondary' variant='contained' size='large'>\n          Додати авто\n        </Button>\n      </form>\n    </Box>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/title-with-icon/index.tsx",[],["313","314"],"/home/taras/dev/the-best-au