e.breakpoints.down('md'))\n  return (\n    <>\n      <Section>\n        <Box textAlign='center'>\n          <Box fontSize={50} lineHeight={0}>\n            <VpnKeyTwoToneIcon fontSize='inherit' color='secondary' />\n          </Box>\n          <Typography variant={matches ? 'h3' : 'h2'}>АВТО З АМЕРИКИ, ЄВРОПИ, КАНАДИ</Typography>\n          <Typography color='secondary' variant={matches ? 'h3' : 'h2'}>\n            ПІД КЛЮЧ\n          </Typography>\n        </Box>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={<BusinessCenterIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАШІ'\n          secondaryText='ПОСЛУГИ'\n        />\n        <ServicesGrid>\n          <ServicesGridItem>\n            <ServicesCard icon={<DriveEtaIcon fontSize='inherit' />} text='ПІДБІР АВТОМОБІЛЯ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<InsertDriveFileIcon fontSize='inherit' />} text='ПЕРЕВІРКА ДОКУМЕНТІВ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<PaymentIcon fontSize='inherit' />} text='ПОКУПКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<LocalShippingIcon fontSize='inherit' />} text='ДОСТАВКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard\n              icon={<VerifiedUserIcon fontSize='inherit' />}\n              text='РОЗМИТНЕННЯ, СЕРТИФІКАЦІЯ, ПОСТАНОВКА НА ОБЛІК'\n            />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<BuildIcon fontSize='inherit' />} text='ДОПОМОГА З РЕМОНТОМ' />\n          </ServicesGridItem>\n        </ServicesGrid>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={\n            <>\n              <InstagramIcon fontSize='inherit' color='secondary' />\n              <YouTubeIcon fontSize='inherit' color='secondary' />\n            </>\n          }\n          primaryText='МИ В'\n          secondaryText='СОЦМЕРЕЖАХ'\n        />\n        <Social />\n      </Section>\n\n      <Divider />\n      {/* <Section>\n        <TitleWithIcon\n          icon={<GroupIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАША'\n          secondaryText='КОМАНДА'\n        />\n      </Section> */}\n    </>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/index.ts",[],["277","278"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/loading-error/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],["279","280"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/category-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/index.ts",[],["281","282"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/categories/index.tsx",[],"/home/taras/dev/the-best-auto/the-be