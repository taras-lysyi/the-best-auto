eprecatedRules":"112"},{"filePath":"197","messages":"198","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"199"},{"filePath":"200","messages":"201","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"202","messages":"203","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"204"},{"filePath":"205","messages":"206","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"102"},{"filePath":"207","messages":"208","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"209","messages":"210","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/taras/dev/the-best-auto/the-best-auto/src/configureStore.ts",[],["211","212"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/routes.ts",[],["213","214"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/product/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/catalog/index.tsx",[],["215","216"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/title-with-icon/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/services-card/index.tsx",[],["217","218"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/instagram/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/App.tsx",["219"],"import CssBaseline from '@material-ui/core/CssBaseline'\nimport { Route } from 'react-router-dom'\nimport { ThemeProvider } from '@material-ui/core/styles'\nimport { theme } from './theme'\nimport { Header, Footer } from './shared/organisms'\nimport { Pages } from 'pages'\nimport Container from '@material-ui/core/Container'\nimport Box from '@material-ui/core/Box'\nimport { useMediaQuery } from '@material-ui/core'\nfunction App() {\n  const matches = useMediaQuery(theme.breakpoints.up('md'))\n  return (\n    <>\n      <CssBaseline />\n      <ThemeProvider theme={theme}>\n        <Route path='/:page?'>\n          <Header />\n          <Container>\n            <Box marginTop={matches ? 15 : 10}>\n              <Pages />\n            </Box>\n          </Container>\n          {/* <Footer /> */}\n        </Route>\n      </ThemeProvider>\n    </>\n  )\n}\n\nexport default App\n",["220","221"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/header/index.tsx",["222","223","224"],"import React, { memo, useMemo, useCallback } from 'react'\nimport { makeStyles, Theme, createStyles, useTheme } from '@material-ui/core/styles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport Box from '@material-ui/core/Box'\nimport AppBar from '@material-ui/core/AppBar'\nimport Toolbar from '@material-ui/core/Toolbar'\nimport { NavLink, useParams } from 'react-router-dom'\nimport IconButton from '@material-ui/core/IconButton'\nimport Typography from '@material-ui/core/Typography'\nimport MenuIcon from '@material-ui/icons/Menu'\nimport Tabs from '@material-ui/core/Tabs'\nimport Tab from '@material-ui/core/Tab'\nimport Drawer from '@material-ui/core/Drawer'\nimport CloseIcon from '@material-ui/icons/Close'\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    root: {\n      display: 'flex',\n    },\n\n    appBar: {\n      background: `linear-gradient(45deg, ${theme.palette.primary.light} 20%, ${theme.palette.primary.dark} 40%)`,\n    },\n\n    grow: {\n      flexGrow: 1,\n    },\n    menuButton: {\n      display: 'none',\n      [theme.breakpoints.down('sm')]: {\n        display: 'block',\n      },\n    },\n    logoLink: {\n      textDecoration: 'none',\n      width: '100%',\n    },\n    logo: {\n      [theme.breakpoints.down('sm')]: {\n        width: '100%',\n        justifyContent: 'center',\n      },\n    },\n    title: {\n      fontWeight: 'bold',\n      color: 'white',\n    },\n    tabs: {\n      width: '100%',\n    },\n    tab: {\n      fontSize: theme.typography.h6.fontSize,\n      padding: 25,\n    },\n  }),\n)\n\nexport const Header = React.memo(() => {\n  console.log('rendered')\n  const classes = useStyles()\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.up('md'))\n  interface ParamTypes {\n    page: string\n  }\n  let { page } = useParams<ParamTypes>()\n  if (page === undefined) {\n    page = ''\n  }\n  const routes = [\n    {\n      path: '',\n      label: 'Головна',\n    },\n    {\n      path: 'catalog',\n      label: 'Каталог',\n    },\n    {\n      path: 'contacts',\n      label: 'Контакти',\n    },\n    {\n      path: 'blog',\n      label: 'Блог',\n    },\n  ]\n  let initialLocation = routes.findIndex(item => `${page}` === item.path)\n  const [selectedTab, setSelectedTab] = React.useState(initialLocation)\n  const handleChange = (event: React.ChangeEvent<{}> | React.MouseEvent, newValue: number) => {\n    setSelectedTab(newValue)\n    window.scrollTo(0, 0)\n  }\n\n  const [drawer, setDrawer] = React.useState(false)\n  const toggleDrawer = (open: boolean) => (event: React.KeyboardEvent | React.MouseEvent) => {\n    if (\n      event &&\n      event.type === 'keydown' &&\n      ((event as React.KeyboardEvent).key === 'Tab' || (event as React.KeyboardEvent).key === 'Shift')\n    ) {\n      return\n    }\n    setDrawer(open)\n  }\n  return (\n    <div className={classes.root}>\n      <AppBar position='fixed' className={classes.appBar}>\n        <Toolbar>\n          <IconButton\n            onClick={toggleDrawer(true)}\n            edge='start'\n            className={classes.menuButton}\n            color='inherit'\n            aria-label='open drawer'>\n            <MenuIcon />\n          </IconButton>\n          <NavLink\n            className={classes.logoLink}\n            to='/'\n            onClick={() => setSelectedTab(0)}\n            style={{ textDecoration: 'none' }}>\n            <Box display='flex' className={classes.logo}>\n              <Typography className={classes.title} variant='h4' noWrap>\n                THE\n              </Typography>\n              <Typography className={classes.title} variant='h4' noWrap>\n                BEST\n              </Typography>\n              <Typography color='secondary' style={{ fontWeight: 'bold' }} noWrap variant='h4'>\n                AUTO\n              </Typography>\n            </Box>\n          </NavLink>\n\n          <div className={classes.grow} />\n          {matches && (\n            <Toolbar>\n              {\n                <Tabs\n                  className={classes.tabs}\n                  value={selectedTab}\n                  indicatorColor='secondary'\n                  textColor='inherit'\n                  onChange={handleChange}\n                  variant='fullWidth'>\n                  {routes.map(item => {\n                    return (\n                      <Tab\n                        label={item.label}\n                        key={item.label}\n                        component={NavLink}\n                        to={`/${item.path}`}\n                        className={classes.tab}\n                        disabled={page === item.path}\n                      />\n                    )\n                  })}\n                </Tabs>\n              }\n            </Toolbar>\n          )}\n        </Toolbar>\n      </AppBar>\n      {!matches && (\n        <Drawer open={drawer} onClose={toggleDrawer(false)}>\n          <IconButton onClick={toggleDrawer(false)}>\n            <CloseIcon />\n          </IconButton>\n          <Tabs\n            className={classes.tabs}\n            orientation='vertical'\n            value={selectedTab}\n            indicatorColor='secondary'\n            textColor='inherit'\n            onChange={(event, newValue) => {\n              handleChange(event, newValue)\n              setDrawer(false)\n            }}\n            variant='fullWidth'>\n            {routes.map(item => {\n              return (\n                <Tab\n                  label={item.label}\n                  key={item.label}\n                  component={NavLink}\n                  to={`/${item.path}`}\n                  className={classes.tab}\n                  disabled={page === item.path}\n                />\n              )\n            })}\n          </Tabs>\n        </Drawer>\n      )}\n    </div>\n  )\n})\n","/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/search/index.tsx",[],["225","226"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/social/index.tsx",[],["227","228"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/skeleton-loader/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/youtube/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/account/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/home/index.tsx",[],"/home/taras