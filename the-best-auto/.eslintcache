res/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/routes.ts",[],["252","253"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/product/index.tsx",["254"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/catalog/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/index.ts",[],["255","256"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/title-with-icon/index.tsx",[],["257","258"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/services-card/index.tsx",[],["259","260"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/instagram/index.tsx",[],["261","262"],"/home/taras/dev/the-best-auto/the-best-auto/src/App.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/header/index.tsx",["263","264","265","266","267"],"/** @jsxImportSource @welldone-software/why-did-you-render */\nimport React, { memo, useMemo, useCallback } from 'react'\nimport { useParams } from 'react-router-dom'\nimport { makeStyles, Theme, createStyles, useTheme } from '@material-ui/core/styles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport Box from '@material-ui/core/Box'\nimport AppBar from '@material-ui/core/AppBar'\nimport Toolbar from '@material-ui/core/Toolbar'\nimport { NavLink } from 'react-router-dom'\nimport IconButton from '@material-ui/core/IconButton'\nimport Typography from '@material-ui/core/Typography'\nimport MenuIcon from '@material-ui/icons/Menu'\nimport Tabs from '@material-ui/core/Tabs'\nimport Tab from '@material-ui/core/Tab'\nimport Drawer from '@material-ui/core/Drawer'\nimport CloseIcon from '@material-ui/icons/Close'\nimport { NavTabs } from 'shared/molecules'\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    root: {\n      display: 'flex',\n    },\n\n    appBar: {\n      background: `linear-gradient(45deg, ${theme.palette.primary.light} 20%, ${theme.palette.primary.dark} 40%)`,\n    },\n\n    grow: {\n      flexGrow: 1,\n    },\n    menuButton: {\n      display: 'none',\n      [theme.breakpoints.down('sm')]: {\n        display: 'block',\n      },\n    },\n    logoLink: {\n      textDecoration: 'none',\n      width: '100%',\n    },\n    logo: {\n      [theme.breakpoints.down('sm')]: {\n        width: '100%',\n        justifyContent: 'center',\n      },\n    },\n    title: {\n      fontWeight: 'bold',\n      color: 'white',\n    },\n    tabs: {\n      width: '100%',\n    },\n    tab: {\n      fontSize: theme.typography.h6.fontSize,\n      padding: 25,\n    },\n  }),\n)\n\ninterface Props {\n  selectedTab: number\n  tabHandleChange: (event: React.ChangeEvent<{}> | React.MouseEvent, newValue: number) => void\n}\n\nconst Header = ({ selectedTab, tabHandleChange }: Props) => {\n  const classes = useStyles()\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.up('md'))\n\n  const [drawer, setDrawer] = React.useState(false)\n  const toggleDrawer = useCallback(\n    (open: boolean) => (event: React.KeyboardEvent | React.MouseEvent) => {\n      if (\n        event &&\n        event.type === 'keydown' &&\n        ((event as React.KeyboardEvent).key === 'Tab' || (event as React.KeyboardEvent).key === 'Shift')\n      ) {\n        return\n      }\n      setDrawer(open)\n    },\n    [],\n  )\n  const usePage = () => {\n    let { page } = useParams<{ page: string }>()\n    return page ? page : ''\n  }\n  let page = usePage()\n  return (\n    <div className={classes.root}>\n      <AppBar position='fixed' className={classes.appBar}>\n        <Toolbar>\n          <IconButton\n            onClick={toggleDrawer(true)}\n            edge='start'\n            className={classes.menuButton}\n            color='inherit'\n            aria-label='open drawer'>\n            <MenuIcon />\n          </IconButton>\n          <Box display='flex' className={classes.logo}>\n            <Typography className={classes.title} variant='h4' noWrap>\n              THE\n            </Typography>\n            <Typography className={classes.title} variant='h4' noWrap>\n              BEST\n            </Typography>\n            <Typography color='secondary' style={{ fontWeight: 'bold' }} noWrap variant='h4'>\n              AUTO\n            </Typography>\n          </Box>\n\n          <div className={classes.grow} />\n          {matches && (\n            <Toolbar>\n              <NavTabs\n                selectedTab={selectedTab}\n                tabHandleChange={tabHandleChange}\n                drawerHandler={toggleDrawer}\n                page={page}\n                matches={matches}\n              />\n            </Toolbar>\n          )}\n        </Toolbar>\n      </AppBar>\n      {!matches && (\n        <Drawer open={drawer} onClose={toggleDrawer(false)}>\n          <IconButton onClick={toggleDrawer(false)}>\n            <CloseIcon />\n          </IconButton>\n          <NavTabs\n            selectedTab={selectedTab}\n            tabHandleChange={tabHandleChange}\n            drawerHandler={toggleDrawer}\n            page={page}\n            matches={matches}\n          />\n        </Drawer>\n      )}\n    </div>\n  )\n}\n\nexport default Header\n","/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/search/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/index.ts",[],["268","269"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/social/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/skeleton-loader/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-a