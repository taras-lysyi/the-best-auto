unt":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"276","messages":"277","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"199"},{"filePath":"278","messages":"279","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"280","messages":"281","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"282","messages":"283","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"231"},{"filePath":"284","messages":"285","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"146"},{"filePath":"286","messages":"287","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"231"},{"filePath":"288","messages":"289","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"290","messages":"291","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"292"},{"filePath":"293","messages":"294","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"146"},{"filePath":"295","messages":"296","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"149"},{"filePath":"297","messages":"298","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"299","messages":"300","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],["301","302"],"/home/taras/dev/the-best-auto/the-best-auto/src/configureStore.ts",[],["303","304"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",["305"],"import axios from 'axios'\nimport { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit'\nimport { LoadingStatusT } from 'shared/types'\n\ninterface GetCategoriesResponseI {\n  category_id: number\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n\n  active: number\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\n\nexport const getCategories = createAsyncThunk('/category/all', async () => {\n  const response = await axios.post('/category/all')\n  return response.data.result\n})\n\ninterface GetCategoriesStructureResponseI {\n  category_id: number\n  breadcrumb: {\n    title: string\n    link: string\n\n    parent: null | number\n  }\n  child: []\n  childIds: number[]\n  parent: []\n  parentIds: number[]\n\n  linkGo: string\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n  active: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],["306","307"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],["308","309"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],["310","311"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/add/index.tsx",["312","313"],"import { useEffect } from 'react'\nimport { makeStyles, Theme, createStyles } from '@material-ui/core/styles'\nimport { useTypedSelector, useAppDispatch } from 'configureStore'\nimport { selectFormDataIsInitialized } from 'features/crm/features/catalog/selectors'\nimport { getCategories } from 'features/catalog/features/categories/slice'\nimport { selectCategoriesData } from 'features/catalog/features/categories/selectors'\nimport { getBrands, getFeatures, getFeaturesValue } from 'features/catalog/features/filter/slice'\nimport { selectBrands, selectSortedFeaturesWithValues } from 'features/catalog/features/filter/selectors'\nimport { setFormDataIsInitialized, FormDataI, addCRM } from 'features/crm/features/catalog/slice'\nimport Typography from '@material-ui/core/Typography'\nimport Box from '@material-ui/core/Box'\nimport Button from '@material-ui/core/Button'\nimport AddIcon from '@material-ui/icons/Add'\nimport Select from '@material-ui/core/Select'\nimport InputLabel from '@material-ui/core/InputLabel'\nimport FormControl from '@material-ui/core/FormControl'\nimport MenuItem from '@material-ui/core/MenuItem'\nimport FormHelperText from '@material-ui/core/FormHelperText'\nimport TextField from '@material-ui/core/TextField'\nimport Checkbox from '@material-ui/core/Checkbox'\nimport FormControlLabel from '@material-ui/core/FormControlLabel'\nimport Chip from '@material-ui/core/Chip'\nimport Input from '@material-ui/core/Input'\nimport ListItemText from '@material-ui/core/ListItemText'\nimport { useForm, Controller } from 'react-hook-form'\n\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    icon: {\n      cursor: 'pointer',\n      '&:hover': {\n        backgroundColor: theme.palette.secondary.main,\n      },\n    },\n    formControl: {\n      margin: theme.spacing(1),\n      minWidth: 200,\n    },\n    chips: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      maxWidth: 900,\n    },\n    chip: {\n      margin: 2,\n    },\n  }),\n)\nconst ITEM_HEIGHT = 48\nconst ITEM_PADDING_TOP = 8\nconst MenuProps = {\n  PaperProps: {\n    style: {\n      maxHeight: ITEM_HEIGHT * 4.5 + ITEM_PADDING_TOP,\n      width: 250,\n    },\n  },\n}\n\ninterface Inputs {\n  itemId: null | number\n  dateActive: null\n  timeActive: null\n  title: string\n  images: string[]\n  categoryId: null | number\n  brandId: null | number\n  productCode: string\n  vin: string\n  mileage: number\n  ml: 0 | 1\n  year: string\n  price: number\n  offerPrice: null | number\n  available: 0 | 1\n  description: string\n  note: string\n  popular: 0 | 1\n  new: 0 | 1\n  sale: 0 | 1\n  sold: 0 | 1\n  active: 0 | 1\n  features: [\n    {\n      featureId: number\n      featureValueId: number\n      featureValue: string\n    },\n  ][]\n  variant: []\n}\n\nexport const Add = () => {\n  const dispatch = useAppDispatch()\n  const formDataInitialized = useTypedSelector(state => selectFormDataIsInitialized(state))\n  const categories = useTypedSelector(state => selectCategoriesData(state))\n  const featuresWithValues = useTypedSelector(state => selectSortedFeaturesWithValues(state))\n  const brands = useTypedSelector(state => selectBrands(state))\n  function generateArrayOfYears() {\n    var max = new Date().getFullYear()\n    var min = max - 70\n    var years = []\n\n    for (var i = max; i >= min; i--) {\n      years.push(i)\n    }\n    return years\n  }\n  const years = generateArrayOfYears()\n  useEffect(() => {\n    if (!formDataInitialized) {\n      Promise.all([\n        dispatch(getCategories()),\n        dispatch(getBrands()),\n        dispatch(getFeatures()),\n        dispatch(getFeaturesValue()),\n        dispatch(setFormDataIsInitialized({ value: true })),\n      ])\n    }\n  }, [formDataInitialized, categories, featuresWithValues, dispatch])\n  const { handleSubmit, errors, control } = useForm<Inputs>({\n    defaultValues: {\n      itemId: null,\n      dateActive: null,\n      timeActive: null,\n      title: '',\n      images: [],\n      categoryId: null,\n      brandId: null,\n      productCode: '',\n      vin: '',\n      mileage: 0,\n      ml: 0,\n      year: '',\n      price: 0,\n      offerPrice: null,\n      available: 0,\n      description: '',\n      note: '',\n      popular: 0,\n      new: 0,\n      sale: 0,\n      sold: 0,\n      active: 0,\n      features: [],\n      variant: [],\n    },\n  })\n  const onSubmit = (data: Inputs) => {\n    data.images = []\n    data.itemId = null\n    data.productCode = '0'\n    data.timeActive = null\n    data.dateActive = null\n    data.variant = []\n    data.active = 0\n    data.available = 0\n    data.sold = 0\n    const sortedFeatures: {\n      featureId: number\n      featureValueId: number\n      featureValue?: string\n    }[] = []\n    data.features.forEach(item => {\n      sortedFeatures.push(...item)\n      sortedFeatures.forEach(item => {\n        delete item.featureValue\n      })\n    })\n\n    const bodyData: FormDataI = Object.assign(data)\n    bodyData.features = sortedFeatures\n    dispatch(addCRM(bodyData)).then(result => {\n      if (result.meta.requestStatus === 'fulfilled') {\n        window.location.href = `/crm/catalog/edit/${result.payload.item_id}`\n      }\n    })\n  }\n  const classes = useStyles()\n\n  const handleChange = ([event]: any) => {\n    return event.target.value\n  }\n\n  return (\n    <Box textAlign='center'>\n      <form onSubmit={handleSubmit(onSubmit)}>\n        <FormControl className={classes.formControl} error={Boolean(errors.categoryId)}>\n          <InputLabel id='category-select-label'>Категорiя</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {categories.map(category => {\n                  return <MenuItem value={category.category_id}>{category.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='categoryId'\n            rules={{ required: `Категорiя обов'язкова!` }}\n            control={control}\n          />\n          <FormHelperText>{errors.categoryId && errors.categoryId.message}</FormHelperText>\n        </FormControl>\n\n        <FormControl className={classes.formControl} error={Boolean(errors.title)}>\n          <Controller\n            error={Boolean(errors.title)}\n            as={TextField}\n            rules={{ required: `Назва обов'язкова!` }}\n            name='title'\n            label='Повна назва'\n            control={control}\n          />\n          <FormHelperText>{errors.title && errors.title.message}</FormHelperText>\n        </FormControl>\n        <FormControl\n          className={classes.formControl}\n          // error={Boolean(errors.brandId)}\n        >\n          <InputLabel id='brand-select-label'>Марка</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {brands.map(brand => {\n                  return <MenuItem value={brand.brand_id}>{brand.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='brandId'\n            // rules={{ required: `Марка обов'язкова!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.brandId && errors.brandId.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller as={TextField} name='vin' label='VIN номер' control={control} defaultValue='' />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.price)}>\n          <Controller\n            error={Boolean(errors.price)}\n            type='number'\n            rules={{ required: `Актуальна цiна обо'язкова` }}\n            as={TextField}\n            name='price'\n            label='Актуальна цiна ($)'\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.price && errors.price.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            type='number'\n            name='offerPrice'\n            label='Стара цiна ($)'\n            control={control}\n            defaultValue={null}\n          />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.mileage)}>\n          <Controller\n            name='ml'\n            defaultValue={0}\n            control={control}\n            render={props => (\n              <FormControlLabel\n                label='Пробiг в милях'\n                control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n              />\n            )}\n          />\n          <Controller\n            rules={{ required: `Пробiг обов'язковий!` }}\n            as={TextField}\n            name='mileage'\n            value\n            label='Пробiг'\n            control={control}\n            type='number'\n            defaultValue={0}\n          />\n          <FormHelperText>{errors.mileage && errors.mileage.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.year)}>\n          <InputLabel id='year-select-label'>Рiк випуску</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {years.map(year => {\n                  return <MenuItem value={String(year)}>{year}</MenuItem>\n                })}\n              </Select>\n            }\n            name='year'\n            rules={{ required: `Рiк обов'язковий!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.year && errors.year.message}</FormHelperText>\n        </FormControl>\n        <br />\n        <Controller\n          name='popular'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Топ пропозицiя'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='new'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Новинка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='sale'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Знижка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        {/*\n                <Typography variant='h5'>Характеристика</Typography>\n                <Button variant='contained' color='primary' size='large' endIcon={<AddIcon />}>\n                  Додати характеристику\n                </Button>\n                */}\n        <br />\n        {featuresWithValues.map(featureWithValues => {\n          return (\n            <FormControl className={classes.formControl} key={featureWithValues.feature.feature_id}>\n              <InputLabel id={`feature-${featureWithValues.feature.feature_id}`}>\n                {featureWithValues.feature.feature_name}\n              </InputLabel>\n              <Controller\n                as={\n                  featureWithValues.feature.feature_id >= 10 ? (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      multiple\n                      input={<Input />}\n                      renderValue={selected => (\n                        <div className={classes.chips}>\n                          {(selected as {\n                            featureId: number\n                            featureValueId: number\n                            featureValue: string\n                          }[])\n                            .filter(item => {\n                              return featureWithValues.feature.feature_id === item.featureId\n                            })\n                            .map(value => {\n                              return (\n                                <Chip key={value.featureValueId} label={value.featureValue} className={classes.chip} />\n                              )\n                            })}\n                        </div>\n                      )}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = {\n                          featureId: featureWithValues.feature.feature_id,\n                          featureValueId: featureValueItem.feature_value_id,\n                          featureValue: featureValueItem.feature_value,\n                        }\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  ) : (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      input={<Input />}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = [\n                          {\n                            featureId: featureWithValues.feature.feature_id,\n                            featureValueId: featureValueItem.feature_value_id,\n                            featureValue: featureValueItem.feature_value,\n                          },\n                        ]\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  )\n                }\n                name={`features[${featureWithValues.feature.feature_id}]`}\n                control={control}\n                defaultValue={[]}\n                onChange={handleChange}\n              />\n            </FormControl>\n          )\n        })}\n        <br />\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='description'\n            control={control}\n            variant='outlined'\n            label={`Опис`}\n            multiline\n            rows={4}\n            placeholder='Введiть опис'\n          />\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='note'\n            control={control}\n            variant='outlined'\n            label={`Примiтка (не відображається)`}\n            multiline\n            rows={4}\n            placeholder='Введiть примiтку'\n          />\n        </FormControl>\n        <br />\n        <Button type='submit' color='secondary' variant='contained' size='large'>\n          Додати авто\n        </Button>\n      </form>\n    </Box>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/title-with-icon/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/social/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],["314","315"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/proposition/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/filter-select/index.tsx",[],["316","317"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/edit/index.tsx",["318","319"],"import { useEffect, useState } from 'react'\nimport { useParams } from 'react-router-dom'\nimport Dropzone from 'react-dropzone'\nimport { useForm, Controller } from 'react-hook-form'\n//@ts-ignore\nimport { CopyToClipboard } from 'react-copy-to-clipboard'\nimport { useTypedSelector, useAppDispatch } from 'configureStore'\nimport { makeStyles, Theme, createStyles } from '@material-ui/core/styles'\nimport {\n  selectFormDataIsInitialized,\n  selectProductDataIsInitialized,\n  selectProductDataStatus,\n  selectProductData,\n  selectFiles,\n  selectImages,\n} from 'features/crm/features/catalog/selectors'\nimport {\n  setFormDataIsInitialized,\n  editCRM,\n  deleteCRM,\n  itemsCRM,\n  setProductDataIsInitialized,\n  resetProductData,\n  upload,\n  getFiles,\n  setProductImage,\n  setFirst,\n  removeFiles,\n  removeProductImage,\n  resetProductImages,\n} from 'features/crm/features/catalog/slice'\nimport { getCategories } from 'features/catalog/features/categories/slice'\nimport { selectCategoriesData } from 'features/catalog/features/categories/selectors'\nimport { getBrands, getFeatures, getFeaturesValue } from 'features/catalog/features/filter/slice'\nimport { selectBrands, selectSortedFeaturesWithValues } from 'features/catalog/features/filter/selectors'\nimport { SkeletonLoader } from 'shared/molecules'\nimport Typography from '@material-ui/core/Typography'\nimport Box from '@material-ui/core/Box'\nimport ButtonGroup from '@material-ui/core/ButtonGroup'\nimport Button from '@material-ui/core/Button'\nimport IconButton from '@material-ui/core/IconButton'\nimport AddIcon from '@material-ui/icons/Add'\nimport FileCopyIcon from '@material-ui/icons/FileCopy'\nimport EditIcon from '@material-ui/icons/Edit'\nimport PhotoIcon from '@material-ui/icons/Photo'\nimport PhotoLibraryIcon from '@material-ui/icons/PhotoLibrary'\nimport AddPhotoAlternateIcon from '@material-ui/icons/AddPhotoAlternate'\nimport DeleteIcon from '@material-ui/icons/Delete'\nimport WallpaperIcon from '@material-ui/icons/Wallpaper'\nimport PublishIcon from '@material-ui/icons/Publish'\nimport CloudUpload from '@material-ui/icons/CloudUpload'\nimport LibraryAddIcon from '@material-ui/icons/LibraryAdd'\nimport DeleteSweepIcon from '@material-ui/icons/DeleteSweep'\nimport SaveIcon from '@material-ui/icons/Save'\nimport Select from '@material-ui/core/Select'\nimport InputLabel from '@material-ui/core/InputLabel'\nimport FormControl from '@material-ui/core/FormControl'\nimport MenuItem from '@material-ui/core/MenuItem'\nimport FormHelperText from '@material-ui/core/FormHelperText'\nimport TextField from '@material-ui/core/TextField'\nimport Checkbox from '@material-ui/core/Checkbox'\nimport Tooltip from '@material-ui/core/Tooltip'\nimport FormControlLabel from '@material-ui/core/FormControlLabel'\nimport Chip from '@material-ui/core/Chip'\nimport Paper from '@material-ui/core/Paper'\nimport Grid from '@material-ui/core/Grid'\nimport Input from '@material-ui/core/Input'\nimport ListItemText from '@material-ui/core/ListItemText'\nimport Snackbar from '@material-ui/core/Snackbar'\nimport MuiAlert, { AlertProps } from '@material-ui/lab/Alert'\nimport green from '@material-ui/core/colors/green'\nimport red from '@material-ui/core/colors/red'\nimport { findNestedObj } from 'shared/lib/find-nested-obj'\n\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    icon: {\n      cursor: 'pointer',\n      '&:hover': {\n        backgroundColor: theme.palette.secondary.main,\n      },\n    },\n    formControl: {\n      margin: theme.spacing(1),\n      minWidth: 200,\n    },\n    copyField: {\n      '& .MuiInputBase-root.Mui-disabled': {\n        color: 'rgba(0, 0, 0, 0.9)',\n        display: 'flex',\n        alignItems: 'center',\n        minWidth: 350,\n      },\n    },\n    chips: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      maxWidth: 900,\n    },\n    chip: {\n      margin: 2,\n    },\n    paper: {\n      padding: theme.spacing(4),\n    },\n    media: {\n      height: '145px',\n    },\n\n    dropZonePaper: {\n      backgroundColor: '#eee',\n      textAlign: 'center',\n      cursor: 'pointer',\n      color: '#333',\n      padding: '10px',\n      marginTop: '20px',\n    },\n    cloudIcon: {\n      marginTop: '16px',\n      color: '#888888',\n      fontSize: '42px',\n    },\n    download: {\n      color: 'white',\n      backgroundColor: green[500],\n      '&:hover': {\n        backgroundColor: green[700],\n        // Reset on touch devices, it doesn't add specificity\n        '@media (hover: none)': {\n          backgroundColor: green[500],\n        },\n      },\n    },\n\n    delete: {\n      color: 'white',\n      backgroundColor: red[500],\n      '&:hover': {\n        backgroundColor: red[700],\n        // Reset on touch devices, it doesn't add specificity\n        '@media (hover: none)': {\n          backgroundColor: red[500],\n        },\n      },\n    },\n  }),\n)\nconst ITEM_HEIGHT = 48\nconst ITEM_PADDING_TOP = 8\nconst MenuProps = {\n  PaperProps: {\n    style: {\n      maxHeight: ITEM_HEIGHT * 4.5 + ITEM_PADDING_TOP,\n      width: 250,\n    },\n  },\n}\nfunction Alert(props: AlertProps) {\n  return <MuiAlert elevation={6} variant='filled' {...props} />\n}\ninterface Inputs {\n  picture: any\n  itemId: null | number\n  dateActive: null\n  timeActive: null\n  title: string\n  images: string[]\n  categoryId: null | number\n  brandId: null | number\n  productCode: string\n  vin: string\n  mileage: number\n  ml: 0 | 1\n  year: string\n  price: number\n  offerPrice: null | number\n  available: 0 | 1\n  description: string\n  note: string\n  popular: 0 | 1\n  new: 0 | 1\n  sale: 0 | 1\n  sold: 0 | 1\n  active: 0 | 1\n  feature: { [id: number]: string[] }\n  variant: []\n}\n\nexport const Edit = () => {\n  const { productId } = useParams<{ productId: string }>()\n  const productData = useTypedSelector(state => selectProductData(state))\n  const productFiles = useTypedSelector(state => selectFiles(state))\n  const productImages = useTypedSelector(state => selectImages(state))\n  const productDataIsInitialized = useTypedSelector(state => selectProductDataIsInitialized(state))\n  const productDataStatus = useTypedSelector(state => selectProductDataStatus(state))\n  const dispatch = useAppDispatch()\n  const formDataInitialized = useTypedSelector(state => selectFormDataIsInitialized(state))\n  const categories = useTypedSelector(state => selectCategoriesData(state))\n  const featuresWithValues = useTypedSelector(state => selectSortedFeaturesWithValues(state))\n  const brands = useTypedSelector(state => selectBrands(state))\n  const { handleSubmit, errors, control, reset } = useForm()\n\n  function generateArrayOfYears() {\n    var max = new Date().getFullYear()\n    var min = max - 70\n    var years = []\n\n    for (var i = max; i >= min; i--) {\n      years.push(String(i))\n    }\n    return years\n  }\n\n  useEffect(() => {\n    if (!formDataInitialized) {\n      Promise.all([\n        dispatch(getCategories()),\n        dispatch(getBrands()),\n        dispatch(getFeatures()),\n        dispatch(getFeaturesValue()),\n        dispatch(setFormDataIsInitialized({ value: true })),\n      ])\n    }\n  }, [formDataInitialized, categories, featuresWithValues, dispatch])\n\n  useEffect(() => {\n    if (!productDataIsInitialized && productDataStatus === null) {\n      Promise.all([dispatch(itemsCRM([productId])), dispatch(getFiles(productId))]).then(() => {\n        dispatch(setProductDataIsInitialized())\n      })\n    }\n  }, [dispatch, productId, productDataIsInitialized, productDataStatus])\n\n  useEffect(() => {\n    return () => {\n      dispatch(resetProductData())\n    }\n  }, [dispatch])\n\n  const selectHandleChange = ([event]: any) => {\n    return event.target.value\n  }\n\n  const [openSavedAlert, setOpenSavedAlert] = useState(false)\n\n  const handleCloseSavedAlert = (event?: React.SyntheticEvent, reason?: string) => {\n    if (reason === 'clickaway') {\n      return\n    }\n\n    setOpenSavedAlert(false)\n  }\n\n  const [openCopyAlert, setOpenCopyAlert] = useState(false)\n\n  const handleCloseCopyAlert = (event?: React.SyntheticEvent, reason?: string) => {\n    if (reason === 'clickaway') {\n      return\n    }\n\n    setOpenCopyAlert(false)\n  }\n  const onUpload = (value: FileList) => {\n    dispatch(upload({ files: value, itemId: productId })).then(() => dispatch(getFiles(productId)))\n    reset({ images: [] })\n  }\n  const addPhotoToProduct = (fileName: string[]) => {\n    dispatch(setProductImage(fileName))\n  }\n\n  const deletePhoto = (fileName: string, productId: string) => {\n    dispatch(removeFiles({ itemId: productId, name: fileName })).then(() => {\n      dispatch(getFiles(productId))\n    })\n  }\n  const makePhotoFirst = (fileName: string) => {\n    dispatch(setFirst(fileName))\n  }\n\n  const [copy, setCopy] = useState(false)\n\n  const deleteProductImage = (fileName: string) => {\n    dispatch(removeProductImage(fileName))\n  }\n  const deleteProduct = () => {\n    dispatch(deleteCRM({ itemId: productId })).then(() => {\n      window.location.href = `/`\n    })\n  }\n  const onSubmit = (data: Inputs) => {\n    let featuresData:\n      | [\n          {\n            featureId: number\n            featureValueId: number\n          }[],\n        ]\n      | any[] = []\n    for (let prop in data.feature) {\n      // eslint-disable-next-line\n      data.feature[prop].forEach(item => {\n        const feature = findNestedObj(featuresWithValues, 'feature_value', item)\n        featuresData = [\n          ...featuresData,\n          {\n            featureId: feature?.feature_id,\n            featureValueId: feature?.feature_value_id,\n          },\n        ]\n      })\n    }\n    const bodyData = Object.assign(data)\n    delete bodyData.feature\n    bodyData.features = featuresData\n    bodyData.images = productImages\n    bodyData.productCode = '0'\n    bodyData.timeActive = null\n    bodyData.dateActive = null\n    bodyData.variant = {}\n    bodyData.active = 1\n    bodyData.available = 1\n    bodyData.sold = 0\n    bodyData.itemId = productData?.item_id\n    if (bodyData.description === '') {\n      bodyData.description = []\n    }\n    if (bodyData.note === '') {\n      bodyData.note = []\n    }\n    if (bodyData.offerPrice === undefined) {\n      bodyData.offerPrice = null\n    }\n    dispatch(editCRM(bodyData)).then(result => {\n      if (result.meta.requestStatus === 'fulfilled') {\n        setOpenSavedAlert(true)\n      }\n    })\n  }\n  const classes = useStyles()\n\n  return (\n    <>\n      {productDataIsInitialized ? (\n        <>\n          <Box textAlign='center'>\n            <Typography variant='h4'>\n              Редагування авто: {productData?.title}\n              <Box ml={2}>\n                <EditIcon fontSize='large' color='secondary' />\n              </Box>\n            </Typography>\n            <Box textAlign='left'>\n              <Typography variant='h6'>Данi користувача</Typography>\n              <Box display='flex' textAlign='center'>\n                <Box m={1}>{productData?.user.name}</Box>\n                <Box m={1}>{productData?.user.phone}</Box>\n                <Box m={1}>{productData?.user.email}</Box>\n              </Box>\n            </Box>\n            <form onSubmit={handleSubmit(onSubmit)}>\n              <Box m={2}>\n                <Paper square className={classes.paper} variant='outlined'>\n                  <Typography variant='h5'>\n                    Фотографії\n                    <Box ml={2}>\n                      <PhotoIcon fontSize='large' color='secondary' />\n                    </Box>\n                  </Typography>\n                  {productImages.length !== 0 && (\n                    <>\n                      <Box textAlign='right' m={2}>\n                        <Button\n                          onClick={() => dispatch(resetProductImages())}\n                          variant='outlined'\n                          className={classes.delete}\n                          size='large'\n                          endIcon={<DeleteSweepIcon fontSize='large' />}>\n                          Видалити усi\n                        </Button>\n                      </Box>\n                      <Grid container spacing={2} justify='center'>\n                        {productImages.map((fileName: string, index: number) => (\n                          <Grid item key={fileName}>\n                            <Box border={1} borderColor={index === 0 ? 'green' : null}>\n                              <img\n                                className={classes.media}\n                                src={`https://the-best-auto.com/assets/catalog/${productId}/${fileName}.jpg`}\n                                alt={fileName}\n                              />\n                              <Box>\n                                {index !== 0 && (\n                                  <IconButton onClick={() => makePhotoFirst(fileName)}>\n                                    <WallpaperIcon color='primary' />\n                                  </IconButton>\n                                )}\n                                <IconButton onClick={() => deleteProductImage(fileName)}>\n                                  <DeleteIcon color='primary' />\n                                </IconButton>\n                              </Box>\n                            </Box>\n                          </Grid>\n                        ))}\n                      </Grid>\n                    </>\n                  )}\n                </Paper>\n              </Box>\n              {productFiles.data.length !== 0 && (\n                <Box m={2}>\n                  <Paper square className={classes.paper} variant='outlined'>\n                    <Typography variant='h5'>\n                      Галерея\n                      <Box ml={2}>\n                        <PhotoLibraryIcon fontSize='large' color='secondary' />\n                      </Box>\n                    </Typography>\n                    <Box textAlign='right' m={2}>\n                      <Button\n                        onClick={() => addPhotoToProduct(productFiles.data)}\n                        variant='outlined'\n                        className={classes.download}\n                        size='large'\n                        endIcon={<LibraryAddIcon fontSize='large' />}>\n                        Додати уci\n                      </Button>\n                    </Box>\n                    <Grid container spacing={2} justify='center'>\n                      {productFiles.data.map((fileName: string) => (\n                        <Grid item key={fileName}>\n                          <Box border={1}>\n                            <img\n                              className={classes.media}\n                              src={`https://the-best-auto.com/assets/catalog/${productId}/${fileName}`}\n                              alt={fileName}\n                            />\n                            <Box>\n                              <IconButton onClick={() => addPhotoToProduct([fileName])}>\n                                <AddPhotoAlternateIcon color='primary' />\n                              </IconButton>\n                              <IconButton onClick={() => deletePhoto(fileName, productId)}>\n                                <DeleteIcon color='primary' />\n                              </IconButton>\n                            </Box>\n                          </Box>\n                        </Grid>\n                      ))}\n                    </Grid>\n                  </Paper>\n                </Box>\n              )}\n              <Controller\n                control={control}\n                name='images'\n                defaultValue={[]}\n                render={({ onChange, onBlur, value }) => (\n                  <>\n                    <Box m={2}>\n                      <Dropzone accept='image/png, image/jpg, image/jpeg' onDrop={onChange}>\n                        {({ getRootProps, getInputProps }) => (\n                          <Paper variant='outlined' className={classes.dropZonePaper} {...getRootProps()}>\n                            <CloudUpload className={classes.cloudIcon} />\n                            <input {...getInputProps()} name='images' onBlur={onBlur} />\n                            <p>Перетягнiть файли сюди або натиснiть, щоб вибрати</p>\n                          </Paper>\n                        )}\n                      </Dropzone>\n                    </Box>\n\n                    {value.length !== 0 && (\n                      <Box m={2}>\n                        <Paper square className={classes.paper} variant='outlined'>\n                          <Grid container spacing={2} justify='center'>\n                            {value.map((file: any, index: string) => (\n                              <Grid item key={index}>\n                                <img className={classes.media} src={URL.createObjectURL(file)} alt={file.name} />\n                              </Grid>\n                            ))}\n                          </Grid>\n                          <Box mt={2}>\n                            <Button\n                              onClick={() => onUpload(value)}\n                              className={classes.download}\n                              size='large'\n                              variant='contained'\n                              endIcon={<PublishIcon />}>\n                              Завантажити\n                            </Button>\n                          </Box>\n                        </Paper>\n                      </Box>\n                    )}\n                  </>\n                )}\n              />\n              <FormControl className={classes.formControl} error={Boolean(errors.categoryId)}>\n                <InputLabel id='category-select-label'>Категорiя</InputLabel>\n                <Controller\n                  as={\n                    <Select>\n                      {categories.map(category => {\n                        return <MenuItem value={category.category_id}>{category.name}</MenuItem>\n                      })}\n                    </Select>\n                  }\n                  name='categoryId'\n                  defaultValue={productData?.category_id}\n                  rules={{ required: `Категорiя обов'язкова!` }}\n                  control={control}\n                />\n                <FormHelperText>{errors.categoryId && errors.categoryId.message}</FormHelperText>\n              </FormControl>\n              <FormControl className={classes.formControl} error={Boolean(errors.title)}>\n                <Controller\n                  error={Boolean(errors.title)}\n                  as={TextField}\n                  rules={{ required: `Назва обов'язкова!` }}\n                  name='title'\n                  defaultValue={productData?.title}\n                  label='Повна назва'\n                  control={control}\n                />\n                <FormHelperText>{errors.title && errors.title.message}</FormHelperText>\n              </FormControl>\n              <FormControl\n                className={classes.formControl}\n                // error={Boolean(errors.brandId)}\n              >\n                <InputLabel id='brand-select-label'>Марка</InputLabel>\n                <Controller\n                  as={\n                    <Select>\n                      {brands.map(brand => {\n                        return <MenuItem value={brand.brand_id}>{brand.name}</MenuItem>\n                      })}\n                    </Select>\n                  }\n                  name='brandId'\n                  defaultValue={productData?.brand_id}\n                  // rules={{ required: `Марка обов'язкова!` }}\n                  control={control}\n                />\n                <FormHelperText>{errors.brandId && errors.brandId.message}</FormHelperText>\n              </FormControl>\n              <FormControl className={classes.formControl}>\n                <Controller\n                  as={TextField}\n                  name='vin'\n                  defaultValue={productData?.vin}\n                  label='VIN номер'\n                  control={control}\n                />\n              </FormControl>\n              <FormControl className={classes.formControl} error={Boolean(errors.price)}>\n                <Controller\n                  error={Boolean(errors.price)}\n                  type='number'\n                  rules={{ required: `Актуальна цiна обов'язкова` }}\n                  as={TextField}\n                  name='price'\n                  defaultValue={productData?.price}\n                  label='Актуальна цiна ($)'\n                  control={control}\n                />\n              </FormControl>\n              <FormControl className={classes.formControl}>\n                <Controller\n                  type='number'\n                  as={TextField}\n                  name='price'\n                  defaultValue={productData?.offerPrice}\n                  label='Стара цiна ($)'\n                  control={control}\n                />\n              </FormControl>\n              <FormControl className={classes.formControl} error={Boolean(errors.mileage)}>\n                <Controller\n                  name='ml'\n                  defaultValue={productData?.ml}\n                  control={control}\n                  render={props => (\n                    <FormControlLabel\n                      label='Пробiг в милях'\n                      control={\n                        <Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />\n                      }\n                    />\n                  )}\n                />\n                <Controller\n                  rules={{ required: `Пробiг обов'язковий!` }}\n                  as={TextField}\n                  name='mileage'\n                  defaultValue={productData?.mileage}\n                  value\n                  label='Пробiг'\n                  control={control}\n                  type='number'\n                />\n                <FormHelperText>{errors.mileage && errors.mileage.message}</FormHelperText>\n              </FormControl>\n              <FormControl className={classes.formControl} error={Boolean(errors.year)}>\n                <InputLabel id='year-select-label'>Рiк випуску</InputLabel>\n                <Controller\n                  as={\n                    <Select>\n                      {generateArrayOfYears().map(year => {\n                        return <MenuItem value={year}>{year}</MenuItem>\n                      })}\n                    </Select>\n                  }\n                  name='year'\n                  defaultValue={productData?.year}\n                  rules={{ required: `Рiк обов'язковий!` }}\n                  control={control}\n                />\n                <FormHelperText>{errors.year && errors.year.message}</FormHelperText>\n              </FormControl>\n              <br />\n              <Controller\n                name='popular'\n                defaultValue={productData?.popular}\n                control={control}\n                render={props => (\n                  <FormControlLabel\n                    label='Топ пропозицiя'\n                    control={\n                      <Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />\n                    }\n                  />\n                )}\n              />\n              <Controller\n                name='new'\n                defaultValue={productData?.new}\n                control={control}\n                render={props => (\n                  <FormControlLabel\n                    label='Новинка'\n                    control={\n                      <Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />\n                    }\n                  />\n                )}\n              />\n              <Controller\n                name='sale'\n                defaultValue={productData?.sale}\n                control={control}\n                render={props => (\n                  <FormControlLabel\n                    label='Знижка'\n                    control={\n                      <Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />\n                    }\n                  />\n                )}\n              />\n              {/*\n                        <Typography variant='h5'>Характеристика</Typography>\n                        <Button variant='contained' color='primary' size='large' endIcon={<AddIcon />}>\n                          Додати характеристику\n                        </Button>\n                        */}\n              <br />\n              {featuresWithValues.map(featureWithValuesItem => {\n                return (\n                  <FormControl className={classes.formControl} key={featureWithValuesItem.feature.feature_id}>\n                    <InputLabel id={`feature-${featureWithValuesItem.feature.feature_id}`}>\n                      {featureWithValuesItem.feature.feature_name}\n                    </InputLabel>\n                    <Controller\n                      name={`feature[${featureWithValuesItem.feature.feature_id}]`}\n                      defaultValue={\n                        productData.feature[featureWithValuesItem.feature.feature_id] !== undefined\n                          ? productData.feature[featureWithValuesItem.feature.feature_id]\n                          : []\n                      }\n                      control={control}\n                      onChange={selectHandleChange}\n                      as={\n                        featureWithValuesItem.feature.feature_id >= 10 ? (\n                          <Select\n                            labelId={`feature-${featureWithValuesItem.feature.feature_id}`}\n                            id={`select-feature-${featureWithValuesItem.feature.feature_id}`}\n                            multiple\n                            input={<Input />}\n                            renderValue={selected => (\n                              <div className={classes.chips}>\n                                {(selected as string[]).map(value => {\n                                  return <Chip key={value} label={value} className={classes.chip} />\n                                })}\n                              </div>\n                            )}\n                            MenuProps={MenuProps}>\n                            {featureWithValuesItem.featuresValueItems.map(featureValueItem => {\n                              return (\n                                <MenuItem\n                                  key={featureValueItem.feature_value_id}\n                                  value={featureValueItem.feature_value}>\n                                  <ListItemText primary={featureValueItem.feature_value} />\n                                </MenuItem>\n                              )\n                            })}\n                          </Select>\n                        ) : (\n                          <Select\n                            labelId={`feature-${featureWithValuesItem.feature.feature_id}`}\n                            id={`select-feature-${featureWithValuesItem.feature.feature_id}`}\n                            input={<Input />}\n                            MenuProps={MenuProps}>\n                            {featureWithValuesItem.featuresValueItems.map(featureValueItem => {\n                              return (\n                                <MenuItem\n                                  key={featureValueItem.feature_value_id}\n                                  value={featureValueItem.feature_value}>\n                                  <ListItemText primary={featureValueItem.feature_value} />\n                                </MenuItem>\n                              )\n                            })}\n                          </Select>\n                        )\n                      }\n                    />\n                  </FormControl>\n                )\n              })}\n              <br />\n              <FormControl className={classes.formControl}>\n                <Controller\n                  as={TextField}\n                  name='description'\n                  defaultValue={productData?.description}\n                  control={control}\n                  variant='outlined'\n                  label={`Опис`}\n                  multiline\n                  rows={4}\n                  placeholder='Введiть опис'\n                />\n              </FormControl>\n              <FormControl className={classes.formControl}>\n                <Controller\n                  as={TextField}\n                  name='note'\n                  defaultValue={productData?.note}\n                  control={control}\n                  variant='outlined'\n                  label={`Примiтка (не відображається)`}\n                  multiline\n                  rows={4}\n                  placeholder='Введiть примiтку'\n                />\n              </FormControl>\n              <br />\n              <Box m={1}>\n                <TextField\n                  disabled\n                  className={classes.copyField}\n                  value={`https://the-best-auto.com/product/${productId}`}\n                  InputProps={{\n                    endAdornment: (\n                      <Tooltip title='Скопiювати'>\n                        <CopyToClipboard\n                          text={`https://the-best-auto.com/product/${productId}`}\n                          onCopy={() => {\n                            setCopy(true)\n                            setOpenCopyAlert(true)\n                          }}>\n                          <IconButton>\n                            <FileCopyIcon />\n                          </IconButton>\n                        </CopyToClipboard>\n                      </Tooltip>\n                    ),\n                  }}\n                />\n              </Box>\n              <br />\n              <ButtonGroup variant='contained' size='large'>\n                <Button endIcon={<SaveIcon />} className={classes.download} type='submit' color='secondary'>\n                  Зберегти\n                </Button>\n                <Button onClick={() => deleteProduct()} endIcon={<DeleteIcon />} className={classes.delete}>\n                  Видалити авто\n                </Button>\n              </ButtonGroup>\n            </form>\n\n            <Snackbar\n              open={openCopyAlert}\n              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}\n              autoHideDuration={3000}\n              onClose={handleCloseCopyAlert}>\n              <Alert onClose={handleCloseCopyAlert} severity='info'>\n                Посилання на авто скопiйовано\n              </Alert>\n            </Snackbar>\n            <Snackbar\n              open={openSavedAlert}\n              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}\n              autoHideDuration={3000}\n              onClose={handleCloseSavedAlert}>\n              <Alert onClose={handleCloseSavedAlert} severity='success'>\n                Авто збережено i доступне в каталозi\n              </Alert>\n            </Snackbar>\n          </Box>\n        </>\n      ) : (\n        <SkeletonLoader />\n      )}\n    </>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/App.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/routes.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/product/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/index.ts",[],["320","321"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-up/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/lib/find-nested-obj.ts",[],["322","323"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/index.ts",[],"