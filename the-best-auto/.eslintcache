ice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],["298","299"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",["300"],"import axios from 'axios'\nimport { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit'\nimport { LoadingStatusT } from 'shared/types'\n\ninterface GetCategoriesResponseI {\n  category_id: number\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n\n  active: number\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\n\nexport const getCategories = createAsyncThunk('/category/all', async () => {\n  const response = await axios.post('/category/all')\n  return response.data.result\n})\n\ninterface GetCategoriesStructureResponseI {\n  category_id: number\n  breadcrumb: {\n    title: string\n    link: string\n\n    parent: null | number\n  }\n  child: []\n  childIds: number[]\n  parent: []\n  parentIds: number[]\n\n  linkGo: string\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n  active: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],["301","302"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],["303","304"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],["305","306"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-aut