 useAppDispatch } from 'configureStore'\nimport Grid from '@material-ui/core/Grid'\nimport TextField from '@material-ui/core/TextField'\nimport Slider from '@material-ui/core/Slider'\n\ninterface FilterSliderProps {\n  min: number\n  max: number\n  onChange: ((event: React.ChangeEvent<{}>, value: number | number[]) => void) | undefined\n  onChangeCommitedAction: (payload: number | number[]) => any\n  value: number[]\n}\n\nexport const FilterSlider = memo(({ min, max, onChangeCommitedAction, onChange, value }: FilterSliderProps) => {\n  const dispatch = useAppDispatch()\n  const onChangeCommited = (event: any, newValue: number | number[]) => {\n    dispatch(onChangeCommitedAction(newValue as number[]))\n  }\n  return (\n    <Grid container spacing={1}>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? min : value[0]} fullWidth type='number' label='від' />\n      </Grid>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? max : value[1]} fullWidth type='number' label='до' />\n      </Grid>\n      <Grid item xs={12} md={12}>\n        <Slider\n          onChangeCommitted={onChangeCommited}\n          min={min}\n          max={max}\n          onChange={onChange}\n          value={value[1] === 0 ? [min, max] : value}\n          color='secondary'\n          valueLabelDisplay='auto'\n          aria-labelledby='range-slider'\n        />\n      </Grid>\n    </Grid>\n  )\n})\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control/index.tsx",[],["257","258"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras