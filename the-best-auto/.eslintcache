the-best-auto/src/features/social-media/molecules/index.ts",[],["246","247"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/instagram/index.tsx",[],["248","249"],"/home/taras/dev/the-best-auto/the-best-auto/src/App.tsx",[],["250","251"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/header/index.tsx",[],["252","253"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/index.ts",[],["254","255"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/social/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/skeleton-loader/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/youtube/index.tsx",[],["256","257"],"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/home/index.tsx",["258"],"import { useTheme } from '@material-ui/core/styles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport { Section } from 'shared/atoms'\nimport { TitleWithIcon } from 'shared/molecules'\nimport { ServicesGrid, ServicesGridItem } from 'features/services/atoms'\nimport { ServicesCard } from 'features/services/molecules'\nimport Box from '@material-ui/core/Box'\nimport Typography from '@material-ui/core/Typography'\nimport Divider from '@material-ui/core/Divider'\nimport VpnKeyTwoToneIcon from '@material-ui/icons/VpnKeyTwoTone'\nimport BusinessCenterIcon from '@material-ui/icons/BusinessCenter'\nimport DriveEtaIcon from '@material-ui/icons/DriveEta'\nimport InsertDriveFileIcon from '@material-ui/icons/InsertDriveFile'\nimport PaymentIcon from '@material-ui/icons/Payment'\nimport LocalShippingIcon from '@material-ui/icons/LocalShipping'\nimport VerifiedUserIcon from '@material-ui/icons/VerifiedUser'\nimport BuildIcon from '@material-ui/icons/Build'\nimport InstagramIcon from '@material-ui/icons/Instagram'\nimport YouTubeIcon from '@material-ui/icons/YouTube'\nimport { Social } from 'features/social-media/organisms'\nimport GroupIcon from '@material-ui/icons/Group'\n\nexport const HomePage = () => {\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.down('md'))\n  return (\n    <>\n      <Section>\n        <Box textAlign='center'>\n          <Box fontSize={50} lineHeight={0}>\n            <VpnKeyTwoToneIcon fontSize='inherit' color='secondary' />\n          </Box>\n          <Typography variant={matches ? 'h3' : 'h2'}>АВТО З АМЕРИКИ, ЄВРОПИ, КАНАДИ</Typography>\n          <Typography color='secondary' variant={matches ? 'h3' : 'h2'}>\n            ПІД КЛЮЧ\n          </Typography>\n        </Box>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={<BusinessCenterIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАШІ'\n          secondaryText='ПОСЛУГИ'\n        />\n        <ServicesGrid>\n          <ServicesGridItem>\n            <ServicesCard icon={<DriveEtaIcon fontSize='inherit' />} text='ПІДБІР АВТОМОБІЛЯ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<InsertDriveFileIcon fontSize='inherit' />} text='ПЕРЕВІРКА ДОКУМЕНТІВ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<PaymentIcon fontSize='inherit' />} text='ПОКУПКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<LocalShippingIcon fontSize='inherit' />} text='ДОСТАВКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard\n              icon={<VerifiedUserIcon fontSize='inherit' />}\n              text='РОЗМИТНЕННЯ, СЕРТИФІКАЦІЯ, ПОСТАНОВКА НА ОБЛІК'\n            />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<BuildIcon fontSize='inherit' />} text='ДОПОМОГА З РЕМОНТОМ' />\n          </ServicesGridItem>\n        </ServicesGrid>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={\n            <>\n              <InstagramIcon fontSize='inherit' color='secondary' />\n              <YouTubeIcon fontSize='inherit' color='secondary' />\n            </>\n          }\n          primaryText='МИ В'\n          secondaryText='СОЦМЕРЕЖАХ'\n        />\n        <Social />\n      </Section>\n\n      <Divider />\n      {/* <Section>\n        <TitleWithIcon\n          icon={<GroupIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАША'\n          secondaryText='КОМАНДА'\n        />\n      </Section> */}\n    </>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/index.ts",[],["259","260"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/loading-error/index.tsx",[],["261","262"],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms