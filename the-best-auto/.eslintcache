yles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport { Section } from 'shared/atoms'\nimport { TitleWithIcon } from 'shared/molecules'\nimport { ServicesGrid, ServicesGridItem } from 'features/services/atoms'\nimport { ServicesCard } from 'features/services/molecules'\nimport Box from '@material-ui/core/Box'\nimport Typography from '@material-ui/core/Typography'\nimport Divider from '@material-ui/core/Divider'\nimport VpnKeyTwoToneIcon from '@material-ui/icons/VpnKeyTwoTone'\nimport BusinessCenterIcon from '@material-ui/icons/BusinessCenter'\nimport DriveEtaIcon from '@material-ui/icons/DriveEta'\nimport InsertDriveFileIcon from '@material-ui/icons/InsertDriveFile'\nimport PaymentIcon from '@material-ui/icons/Payment'\nimport LocalShippingIcon from '@material-ui/icons/LocalShipping'\nimport VerifiedUserIcon from '@material-ui/icons/VerifiedUser'\nimport BuildIcon from '@material-ui/icons/Build'\nimport InstagramIcon from '@material-ui/icons/Instagram'\nimport YouTubeIcon from '@material-ui/icons/YouTube'\nimport { Social } from 'features/social-media/organisms'\nimport GroupIcon from '@material-ui/icons/Group'\n\nexport const HomePage = () => {\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.down('md'))\n  return (\n    <>\n      <Section>\n        <Box textAlign='center'>\n          <Box fontSize={50} lineHeight={0}>\n            <VpnKeyTwoToneIcon fontSize='inherit' color='secondary' />\n          </Box>\n          <Typography variant={matches ? 'h3' : 'h2'}>АВТО З АМЕРИКИ, ЄВРОПИ, КАНАДИ</Typography>\n          <Typography color='secondary' variant={matches ? 'h3' : 'h2'}>\n            ПІД КЛЮЧ\n          </Typography>\n        </Box>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={<BusinessCenterIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАШІ'\n          secondaryText='ПОСЛУГИ'\n        />\n        <ServicesGrid>\n          <ServicesGridItem>\n            <ServicesCard icon={<DriveEtaIcon fontSize='inherit' />} text='ПІДБІР АВТОМОБІЛЯ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<InsertDriveFileIcon fontSize='inherit' />} text='ПЕРЕВІРКА ДОКУМЕНТІВ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<PaymentIcon fontSize='inherit' />} text='ПОКУПКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<LocalShippingIcon fontSize='inherit' />} text='ДОСТАВКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard\n              icon={<VerifiedUserIcon fontSize='inherit' />}\n              text='РОЗМИТНЕННЯ, СЕРТИФІКАЦІЯ, ПОСТАНОВКА НА ОБЛІК'\n            />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<BuildIcon fontSize='inherit' />} text='ДОПОМОГА З РЕМОНТОМ' />\n          </ServicesGridItem>\n        </ServicesGrid>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={\n            <>\n              <InstagramIcon fontSize='inherit' color='secondary' />\n              <YouTubeIcon fontSize='inherit' color='secondary' />\n            </>\n          }\n          primaryText='МИ В'\n          secondaryText='СОЦМЕРЕЖАХ'\n        />\n        <Social />\n      </Section>\n\n      <Divider />\n      {/* <Section>\n        <TitleWithIcon\n          icon={<GroupIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАША'\n          secondaryText='КОМАНДА'\n        />\n      </Section> */}\n    </>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/loading-error/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/category-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",["297"],"import axios from 'axios'\nimport { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit'\nimport { LoadingStatusT } from 'shared/types'\n\ninterface GetCategoriesResponseI {\n  category_id: number\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n\n  active: number\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\n\nexport const getCategories = createAsyncThunk('/category/all', async () => {\n  const response = await axios.post('/category/all')\n  return response.data.result\n})\n\ninterface GetCategoriesStructureResponseI {\n  category_id: number\n  breadcrumb: {\n    title: string\n    link: string\n\n    parent: null | number\n  }\n  child: []\n  childIds: number[]\n  parent: []\n  parentIds: number[]\n\n  linkGo: string\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n  active: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/categories/index.tsx",[],["298","299"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/theme.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/proposition/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/slider/index.tsx",["300"],"import { memo, useState } from 'react'\nimport { useAppDispatch } from 'configureStore'\nimport Grid from '@material-ui/core/Grid'\nimport TextField from '@material-ui/core/TextField'\nimport Slider from '@material-ui/core/Slider'\n\ninterface FilterSliderProps {\n  min: number\n  max: number\n  onChange: ((event: React.ChangeEvent<{}>, value: number | number[]) => void) | undefined\n  onChangeCommitedAction: (payload: number | number[]) => any\n  value: number[]\n}\n\nexport const FilterSlider = memo(({ min, max, onChangeCommitedAction, onChange, value }: FilterSliderProps) => {\n  const dispatch = useAppDispatch()\n  const onChangeCommited = (event: any, newValue: number | number[]) => {\n    dispatch(onChangeCommitedAction(newValue as number[]))\n  }\n  return (\n    <Grid container spacing={1}>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? min : value[0]} fullWidth type='number' label='від' />\n      </Grid>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? max : value[1]} fullWidth type='number' label='до' />\n      </Grid>\n      <Grid item xs={12} md={12}>\n        <Slider\n          onChangeCommitted={onChangeCommited}\n          min={min}\n          max={max}\n          onChange={onChange}\n          value={value[1] === 0 ? [min, max] : value}\n          color='secondary'\n          valueLabelDisplay='auto'\n          aria-labelledby='range-slider'\n        />\n      </Grid>\n    </Grid>\n  )\n})\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/filter-select/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",["301"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/menu/index.tsx",[],["302","303"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/menu/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/add/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/edit/index.tsx",["304","305","306","307","308","309","310","311","312","313","314","315","316","317","