te, action) => {\n      state.data = action.payload\n      state.initialized = true\n    })\n  },\n})\n\nexport default contactsSlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/contacts/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],{"ruleId":"340","replacedBy":"341"},{"ruleId":"342","replacedBy":"343"},{"ruleId":"340","replacedBy":"344"},{"ruleId":"342","replacedBy":"345"},{"ruleId":"340","replacedBy":"346"},{"ruleId":"342","replacedBy":"347"},{"ruleId":"340","replacedBy":"348"},{"ruleId":"342","replacedBy":"349"},{"ruleId":"340","replacedBy":"350"},{"ruleId":"342","replacedBy":"351"},{"ruleId":"352","severity":1,"message":"353","line":10,"column":8,"nodeType":"354","messageId":"355","endLine":10,"endColumn":18},{"ruleId":"352","severity":1,"message":"356","line":13,"column":8,"nodeType":"354","messageId":"355","endLine":13,"endColumn":15},{"ruleId":"340","replacedBy":"357"},{"ruleId":"342","replacedBy":"358"},{"ruleId":"340","replacedBy":"359"},{"ruleId":"342","replacedBy":"360"},{"ruleId":"340","replacedBy":"361"},{"ruleId":"342","replacedBy":"362"},{"ruleId":"352","severity":1,"message":"363","line":23,"column":11,"nodeType":"354","messageId":"355","endLine":23,"endColumn":42},{"ruleId":"352","severity":1,"message":"356","line":46,"column":8,"nodeType":"354","messageId":"355","endLine":46,"endColumn":15},{"ruleId":"352","severity":1,"message":"364","line":61,"column":8,"nodeType":"354","messageId":"355","endLine":61,"endColumn":18},{"ruleId":"352","severity":1,"message":"365","line":303,"column":10,"nodeType":"354","messageId":"355","endLine":303,"endColumn":14},{"ruleId":"352","severity":1,"message":"366","line":2,"column":41,"nodeType":"354","messageId":"355","endLine":2,"endColumn":54},"no-native-re