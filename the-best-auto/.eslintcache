}\n\nconst initialState: InitialStateI = {\n  status: null,\n  data: null,\n  initialized: false,\n}\n\nconst contactsSlice = createSlice({\n  name: 'contacts',\n  initialState,\n  reducers: {},\n  extraReducers: builder => {\n    builder.addCase(getMapLocations.fulfilled, (state, action) => {\n      state.data = action.payload\n      state.initialized = true\n    })\n  },\n})\n\nexport default contactsSlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/contacts/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],{"ruleId":"342","replacedBy":"343"},{"ruleId":"344","replacedBy":"345"},{"ruleId":"342","replacedBy":"346"},{"ruleId":"344","replacedBy":"347"},{"ruleId":"342","replacedBy":"348"},{"ruleId":"344","replacedBy":"349"},{"ruleId":"342","replacedBy":"350"},{"ruleId":"344","replacedBy":"351"},{"ruleId":"342","replacedBy":"352"},{"ruleId":"344","replacedBy":"353"},{"ruleId":"342","replacedBy":"354"},{"ruleId":"344","replacedBy":"355"},{"ruleId":"356","severity":1,"message":"357","line":10,"column":8,"nodeType":"358","messageId":"359","endLine":10,"endColumn":18},{"ruleId":"356","severity":1,"message":"360","line":13,"column":8,"nodeType":"358","messageId":"359","endLine":13,"endColumn":15},{"ruleId":"342","replacedBy":"361"},{"ruleId":"344","replacedBy":"362"},{"ruleId":"342","replacedBy":"363"},{"ruleId":"344","replacedBy":"364"},{"ruleId":"342","replacedBy":"365"},{"ruleId":"344","replacedBy":"366"},{"ruleId":"356","severity":1,"message":"367","line":23,"column":11,"nodeType":"358","messageId":"359","endLine":23,"endColumn":42},{"ruleId":"356","severity":1,"message":"360","line":46,"column":8,"nodeType":"358","messageId":"359","endLine":46,"endColumn":15},{"ruleId":"356","severity":1,"message":"368","line":61,