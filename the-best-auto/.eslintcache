ared/molecules/skeleton-loader/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/youtube/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/footer/index.tsx",[],["325","326"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/home/index.tsx",["327"],"import { useTheme } from '@material-ui/core/styles'\nimport useMediaQuery from '@material-ui/core/useMediaQuery'\nimport { Section } from 'shared/atoms'\nimport { TitleWithIcon } from 'shared/molecules'\nimport { ServicesGrid, ServicesGridItem } from 'features/services/atoms'\nimport { ServicesCard } from 'features/services/molecules'\nimport Box from '@material-ui/core/Box'\nimport Typography from '@material-ui/core/Typography'\nimport Divider from '@material-ui/core/Divider'\nimport VpnKeyTwoToneIcon from '@material-ui/icons/VpnKeyTwoTone'\nimport BusinessCenterIcon from '@material-ui/icons/BusinessCenter'\nimport DriveEtaIcon from '@material-ui/icons/DriveEta'\nimport InsertDriveFileIcon from '@material-ui/icons/InsertDriveFile'\nimport PaymentIcon from '@material-ui/icons/Payment'\nimport LocalShippingIcon from '@material-ui/icons/LocalShipping'\nimport VerifiedUserIcon from '@material-ui/icons/VerifiedUser'\nimport BuildIcon from '@material-ui/icons/Build'\nimport InstagramIcon from '@material-ui/icons/Instagram'\nimport YouTubeIcon from '@material-ui/icons/YouTube'\nimport { Social } from 'features/social-media/organisms'\nimport GroupIcon from '@material-ui/icons/Group'\n\nexport const HomePage = () => {\n  const theme = useTheme()\n  const matches = useMediaQuery(theme.breakpoints.down('md'))\n  return (\n    <>\n      <Section>\n        <Box textAlign='center'>\n          <Box fontSize={50} lineHeight={0}>\n            <VpnKeyTwoToneIcon fontSize='inherit' color='secondary' />\n          </Box>\n          <Typography variant={matches ? 'h3' : 'h2'}>АВТО З АМЕРИКИ, ЄВРОПИ, КАНАДИ</Typography>\n          <Typography color='secondary' variant={matches ? 'h3' : 'h2'}>\n            ПІД КЛЮЧ\n          </Typography>\n        </Box>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={<BusinessCenterIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАШІ'\n          secondaryText='ПОСЛУГИ'\n        />\n        <ServicesGrid>\n          <ServicesGridItem>\n            <ServicesCard icon={<DriveEtaIcon fontSize='inherit' />} text='ПІДБІР АВТОМОБІЛЯ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<InsertDriveFileIcon fontSize='inherit' />} text='ПЕРЕВІРКА ДОКУМЕНТІВ' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<PaymentIcon fontSize='inherit' />} text='ПОКУПКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<LocalShippingIcon fontSize='inherit' />} text='ДОСТАВКА АВТО' />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard\n              icon={<VerifiedUserIcon fontSize='inherit' />}\n              text='РОЗМИТНЕННЯ, СЕРТИФІКАЦІЯ, ПОСТАНОВКА НА ОБЛІК'\n            />\n          </ServicesGridItem>\n          <ServicesGridItem>\n            <ServicesCard icon={<BuildIcon fontSize='inherit' />} text='ДОПОМОГА З РЕМОНТОМ' />\n          </ServicesGridItem>\n        </ServicesGrid>\n      </Section>\n\n      <Divider />\n\n      <Section>\n        <TitleWithIcon\n          icon={\n            <>\n              <InstagramIcon fontSize='inherit' color='secondary' />\n              <YouTubeIcon fontSize='inherit' color='secondary' />\n            </>\n          }\n          primaryText='МИ В'\n          secondaryText='СОЦМЕРЕЖАХ'\n        />\n        <Social />\n      </Section>\n\n      <Divider />\n      {/* <Section>\n        <TitleWithIcon\n          icon={<GroupIcon fontSize='inherit' color='secondary' />}\n          primaryText='НАША'\n          secondaryText='КОМАНДА'\n        />\n      </Section> */}\n    </>\n  )\n}\n",["328","329"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/loading-error/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/section/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/templates/index.tsx",[],["330","331"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/catalog-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/services-grid/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/category-item/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/atoms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/slice.ts",["332"],"import axios from 'axios'\nimport { createSlice, createAsyncThunk, PayloadAction } from '@reduxjs/toolkit'\nimport { LoadingStatusT } from 'shared/types'\n\ninterface GetCategoriesResponseI {\n  category_id: number\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n\n  active: number\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\n\nexport const getCategories = createAsyncThunk('/category/all', async () => {\n  const response = await axios.post('/category/all')\n  return response.data.result\n})\n\ninterface GetCategoriesStructureResponseI {\n  category_id: number\n  breadcrumb: {\n    title: string\n    link: string\n\n    parent: null | number\n  }\n  child: []\n  childIds: number[]\n  parent: []\n  parentIds: number[]\n\n  linkGo: string\n  parent_id: null | number\n  link: string // onroad\n  name: string // 'Авто в дорози в украину\n  name_once: string | null\n  active: number\n\n  main: number // 1\n  second: number // 0\n  sort: number // 4\n}\ninterface InitialStateI {\n  selectedCategoryId: number[] | []\n\n  selectedCategoryLink: string | null\n  initialized: boolean\n  status: LoadingStatusT\n  categoriesData: GetCategoriesResponseI[]\n}\n\nexport const getCategoriesStructure = createAsyncThunk('/category/getStructure', async () => {\n  const response = await axios.post('/category/getStructure')\n  return response.data.result\n})\n\nconst initialState: InitialStateI = {\n  selectedCategoryId: [],\n  selectedCategoryLink: null,\n  initialized: false,\n  status: null,\n  categoriesData: [],\n}\n\nconst categorySlice = createSlice({\n  name: 'category',\n  initialState,\n  reducers: {\n    setInitializeCategories: (state, action: PayloadAction<boolean>) => {\n      state.initialized = action.payload\n    },\n    setSelectedCategory: (\n      state,\n      action: PayloadAction<{ selectedCategoryId: number[]; selectedCategoryLink: string }>,\n    ) => {\n      state.selectedCategoryId = action.payload.selectedCategoryId\n\n      state.selectedCategoryLink = action.payload.selectedCategoryLink\n    },\n  },\n  extraReducers: builder => {\n    builder.addCase(getCategories.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategories.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategories.rejected, state => {\n      state.status = 'failed'\n    })\n    builder.addCase(getCategoriesStructure.pending, state => {\n      state.status = 'loading'\n    })\n    builder.addCase(getCategoriesStructure.fulfilled, (state, action) => {\n      state.categoriesData = action.payload\n      state.status = 'success'\n    })\n    builder.addCase(getCategoriesStructure.rejected, state => {\n      state.status = 'failed'\n    })\n  },\n})\n\nexport const { setInitializeCategories, setSelectedCategory } = categorySlice.actions\n\nexport default categorySlice.reducer\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/categories/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/templates/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/theme.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/proposition/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/categories/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/slider/index.tsx",["333"],"import { memo, useState } from 'react'\nimport { useAppDispatch } from 'configureStore'\nimport Grid from '@material-ui/core/Grid'\nimport TextField from '@material-ui/core/TextField'\nimport Slider from '@material-ui/core/Slider'\n\ninterface FilterSliderProps {\n  min: number\n  max: number\n  onChange: ((event: React.ChangeEvent<{}>, value: number | number[]) => void) | undefined\n  onChangeCommitedAction: (payload: number | number[]) => any\n  value: number[]\n}\n\nexport const FilterSlider = memo(({ min, max, onChangeCommitedAction, onChange, value }: FilterSliderProps) => {\n  const dispatch = useAppDispatch()\n  const onChangeCommited = (event: any, newValue: number | number[]) => {\n    dispatch(onChangeCommitedAction(newValue as number[]))\n  }\n  return (\n    <Grid container spacing={1}>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? min : value[0]} fullWidth type='number' label='від' />\n      </Grid>\n      <Grid item xs={6} md={6}>\n        <TextField value={value[1] === 0 ? max : value[1]} fullWidth type='number' label='до' />\n      </Grid>\n      <Grid item xs={12} md={12}>\n        <Slider\n          onChangeCommitted={onChangeCommited}\n          min={min}\n          max={max}\n          onChange={onChange}\n          value={value[1] === 0 ? [min, max] : value}\n          color='secondary'\n          valueLabelDisplay='auto'\n          aria-labelledby='range-slider'\n        />\n      </Grid>\n    </Grid>\n  )\n})\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control/index.tsx",[],["334","335"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/checkbox-control-features/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/organisms/carousel/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/nav-tabs/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/product/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/molecules/filter-select/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/crm/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/menu/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/menu/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/add/index.tsx",["336","337","338"],"import { useEffect } from 'react'\nimport { makeStyles, Theme, createStyles } from '@material-ui/core/styles'\nimport { useTypedSelector, useAppDispatch } from 'configureStore'\nimport { selectFormDataIsInitialized } from 'features/crm/features/catalog/selectors'\nimport { getCategories } from 'features/catalog/features/categories/slice'\nimport { selectCategoriesData } from 'features/catalog/features/categories/selectors'\nimport { getBrands, getFeatures, getFeaturesValue } from 'features/catalog/features/filter/slice'\nimport { selectBrands, selectSortedFeaturesWithValues } from 'features/catalog/features/filter/selectors'\nimport { setFormDataIsInitialized, FormDataI, addCRM } from 'features/crm/features/catalog/slice'\nimport Typography from '@material-ui/core/Typography'\nimport Box from '@material-ui/core/Box'\nimport Button from '@material-ui/core/Button'\nimport AddIcon from '@material-ui/icons/Add'\nimport Select from '@material-ui/core/Select'\nimport InputLabel from '@material-ui/core/InputLabel'\nimport FormControl from '@material-ui/core/FormControl'\nimport MenuItem from '@material-ui/core/MenuItem'\nimport FormHelperText from '@material-ui/core/FormHelperText'\nimport TextField from '@material-ui/core/TextField'\nimport Checkbox from '@material-ui/core/Checkbox'\nimport FormControlLabel from '@material-ui/core/FormControlLabel'\nimport Chip from '@material-ui/core/Chip'\nimport Input from '@material-ui/core/Input'\nimport ListItemText from '@material-ui/core/ListItemText'\nimport { useForm, Controller } from 'react-hook-form'\n\nconst useStyles = makeStyles((theme: Theme) =>\n  createStyles({\n    icon: {\n      cursor: 'pointer',\n      '&:hover': {\n        backgroundColor: theme.palette.secondary.main,\n      },\n    },\n    formControl: {\n      margin: theme.spacing(1),\n      minWidth: 200,\n    },\n    chips: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      maxWidth: 900,\n    },\n    chip: {\n      margin: 2,\n    },\n  }),\n)\nconst ITEM_HEIGHT = 48\nconst ITEM_PADDING_TOP = 8\nconst MenuProps = {\n  PaperProps: {\n    style: {\n      maxHeight: ITEM_HEIGHT * 4.5 + ITEM_PADDING_TOP,\n      width: 250,\n    },\n  },\n}\n\ninterface Inputs {\n  itemId: null | number\n  dateActive: null\n  timeActive: null\n  title: string\n  images: string[]\n  categoryId: null | number\n  brandId: null | number\n  productCode: string\n  vin: string\n  mileage: number\n  ml: 0 | 1\n  year: string\n  price: number\n  offerPrice: null | number\n  available: 0 | 1\n  description: string\n  note: string\n  popular: 0 | 1\n  new: 0 | 1\n  sale: 0 | 1\n  sold: 0 | 1\n  active: 0 | 1\n  features: [\n    {\n      featureId: number\n      featureValueId: number\n      featureValue: string\n    },\n  ][]\n  variant: []\n}\n\nexport const Add = () => {\n  const dispatch = useAppDispatch()\n  const formDataInitialized = useTypedSelector(state => selectFormDataIsInitialized(state))\n  const categories = useTypedSelector(state => selectCategoriesData(state))\n  const featuresWithValues = useTypedSelector(state => selectSortedFeaturesWithValues(state))\n  const brands = useTypedSelector(state => selectBrands(state))\n  function generateArrayOfYears() {\n    var max = new Date().getFullYear()\n    var min = max - 70\n    var years = []\n\n    for (var i = max; i >= min; i--) {\n      years.push(i)\n    }\n    return years\n  }\n  const years = generateArrayOfYears()\n  useEffect(() => {\n    if (!formDataInitialized) {\n      Promise.all([\n        dispatch(getCategories()),\n        dispatch(getBrands()),\n        dispatch(getFeatures()),\n        dispatch(getFeaturesValue()),\n        dispatch(setFormDataIsInitialized({ value: true })),\n      ])\n    }\n  }, [formDataInitialized, categories, featuresWithValues, dispatch])\n  const { handleSubmit, errors, control } = useForm<Inputs>({\n    defaultValues: {\n      itemId: null,\n      dateActive: null,\n      timeActive: null,\n      title: '',\n      images: [],\n      categoryId: null,\n      brandId: null,\n      productCode: '',\n      vin: '',\n      mileage: 0,\n      ml: 0,\n      year: '',\n      price: 0,\n      offerPrice: null,\n      available: 0,\n      description: '',\n      note: '',\n      popular: 0,\n      new: 0,\n      sale: 0,\n      sold: 0,\n      active: 0,\n      features: [],\n      variant: [],\n    },\n  })\n  const onSubmit = (data: Inputs) => {\n    console.log(data)\n    data.images = []\n    data.itemId = null\n    data.timeActive = null\n    data.dateActive = null\n    data.variant = []\n    data.active = 0\n    data.available = 0\n    data.sold = 0\n    const sortedFeatures: {\n      featureId: number\n      featureValueId: number\n      featureValue?: string\n    }[] = []\n    // data.features.forEach(item => {\n    //   sortedFeatures.push(...item)\n    //   sortedFeatures.forEach(item => {\n    //     delete item.featureValue\n    //   })\n    // })\n\n    // const bodyData: FormDataI = Object.assign(data)\n    // bodyData.features = sortedFeatures\n    // console.log(bodyData)\n    // dispatch(addCRM(bodyData)).then(result => {\n    //   if (result.meta.requestStatus === 'fulfilled') {\n    //     window.location.href = `/crm/edit/${result.payload.item_id}`\n    //   }\n    // })\n  }\n  const classes = useStyles()\n\n  const handleChange = ([event]: any) => {\n    return event.target.value\n  }\n\n  return (\n    <Box textAlign='center'>\n      <form onSubmit={handleSubmit(onSubmit)}>\n        <FormControl className={classes.formControl} error={Boolean(errors.categoryId)}>\n          <InputLabel id='category-select-label'>Категорiя</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {categories.map(category => {\n                  return <MenuItem value={category.category_id}>{category.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='categoryId'\n            rules={{ required: `Категорiя обов'язкова!` }}\n            control={control}\n          />\n          <FormHelperText>{errors.categoryId && errors.categoryId.message}</FormHelperText>\n        </FormControl>\n\n        <FormControl className={classes.formControl} error={Boolean(errors.title)}>\n          <Controller\n            error={Boolean(errors.title)}\n            as={TextField}\n            rules={{ required: `Назва обов'язкова!` }}\n            name='title'\n            label='Повна назва'\n            control={control}\n          />\n          <FormHelperText>{errors.title && errors.title.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.brandId)}>\n          <InputLabel id='brand-select-label'>Бренд</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {brands.map(brand => {\n                  return <MenuItem value={brand.brand_id}>{brand.name}</MenuItem>\n                })}\n              </Select>\n            }\n            name='brandId'\n            rules={{ required: `Бренд обов'язковий!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.brandId && errors.brandId.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller as={TextField} name='vin' label='VIN номер' control={control} defaultValue='' />\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller as={TextField} name='productCode' label='Внутрiшнiй код авто' control={control} defaultValue='' />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.price)}>\n          <Controller\n            error={Boolean(errors.price)}\n            type='number'\n            rules={{ required: `Актуальна цiна обов'язкова` }}\n            as={TextField}\n            name='price'\n            label='Актуальна цiна ($)'\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.price && errors.price.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            type='number'\n            name='offerPrice'\n            label='Стара цiна ($)'\n            control={control}\n            defaultValue={null}\n          />\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.mileage)}>\n          <Controller\n            name='ml'\n            defaultValue={0}\n            control={control}\n            render={props => (\n              <FormControlLabel\n                label='Пробiг в милях'\n                control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n              />\n            )}\n          />\n          <Controller\n            rules={{ required: `Пробiг обов'язковий!` }}\n            as={TextField}\n            name='mileage'\n            value\n            label='Пробiг'\n            control={control}\n            type='number'\n            defaultValue={0}\n          />\n          <FormHelperText>{errors.mileage && errors.mileage.message}</FormHelperText>\n        </FormControl>\n        <FormControl className={classes.formControl} error={Boolean(errors.year)}>\n          <InputLabel id='year-select-label'>Рiк випуску</InputLabel>\n          <Controller\n            as={\n              <Select>\n                {years.map(year => {\n                  return <MenuItem value={String(year)}>{year}</MenuItem>\n                })}\n              </Select>\n            }\n            name='year'\n            rules={{ required: `Рiк обов'язковий!` }}\n            control={control}\n            defaultValue=''\n          />\n          <FormHelperText>{errors.year && errors.year.message}</FormHelperText>\n        </FormControl>\n        <Typography variant='h5'>Показ на сайтi</Typography>\n        <Controller\n          name='popular'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Топ пропозицiя'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='new'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Новинка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Controller\n          name='sale'\n          defaultValue={0}\n          control={control}\n          render={props => (\n            <FormControlLabel\n              label='Знижка'\n              control={<Checkbox onChange={e => props.onChange(e.target.checked ? 1 : 0)} checked={props.value} />}\n            />\n          )}\n        />\n        <Typography variant='h5'>Характеристика</Typography>\n        <Button variant='contained' color='primary' size='large' endIcon={<AddIcon />}>\n          Додати характеристику\n        </Button>\n        <br />\n        {featuresWithValues.map(featureWithValues => {\n          return (\n            <FormControl className={classes.formControl} key={featureWithValues.feature.feature_id}>\n              <InputLabel id={`feature-${featureWithValues.feature.feature_id}`}>\n                {featureWithValues.feature.feature_name}\n              </InputLabel>\n              <Controller\n                as={\n                  featureWithValues.feature.feature_id >= 10 ? (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      multiple\n                      input={<Input />}\n                      renderValue={selected => (\n                        <div className={classes.chips}>\n                          {(selected as {\n                            featureId: number\n                            featureValueId: number\n                            featureValue: string\n                          }[])\n                            .filter(item => {\n                              return featureWithValues.feature.feature_id === item.featureId\n                            })\n                            .map(value => {\n                              return (\n                                <Chip key={value.featureValueId} label={value.featureValue} className={classes.chip} />\n                              )\n                            })}\n                        </div>\n                      )}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = {\n                          featureId: featureWithValues.feature.feature_id,\n                          featureValueId: featureValueItem.feature_value_id,\n                          featureValue: featureValueItem.feature_value,\n                        }\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  ) : (\n                    <Select\n                      labelId={`feature-${featureWithValues.feature.feature_id}`}\n                      id={`select-feature-${featureWithValues.feature.feature_id}`}\n                      input={<Input />}\n                      MenuProps={MenuProps}>\n                      {featureWithValues.featuresValueItems.map(featureValueItem => {\n                        let value: any = [\n                          {\n                            featureId: featureWithValues.feature.feature_id,\n                            featureValueId: featureValueItem.feature_value_id,\n                            featureValue: featureValueItem.feature_value,\n                          },\n                        ]\n                        return (\n                          <MenuItem key={featureValueItem.feature_value_id} value={value}>\n                            <ListItemText primary={featureValueItem.feature_value} />\n                          </MenuItem>\n                        )\n                      })}\n                    </Select>\n                  )\n                }\n                name={`features[${featureWithValues.feature.feature_id}]`}\n                control={control}\n                defaultValue={[]}\n                onChange={handleChange}\n              />\n            </FormControl>\n          )\n        })}\n        <br />\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='description'\n            control={control}\n            variant='outlined'\n            label={`Опис`}\n            multiline\n            rows={4}\n            placeholder='Введiть опис'\n          />\n        </FormControl>\n        <FormControl className={classes.formControl}>\n          <Controller\n            as={TextField}\n            name='note'\n            control={control}\n            variant='outlined'\n            label={`Примiтка (не відображається)`}\n            multiline\n            rows={4}\n            placeholder='Введiть примiтку'\n          />\n        </FormControl>\n        <br />\n        <Button type='submit' color='secondary' variant='contained' size='large'>\n          Додати авто\n        </Button>\n      </form>\n    </Box>\n  )\n}\n","/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/features/edit/index.tsx",["339","340"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/organisms/file-input/index.tsx",[],["341","342"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-in/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/slice.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/auth/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/auth/organisms/sign-up/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/selectors.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/dashboard/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/crm/features/catalog/organisms/index.ts",[],["343","344"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/lib/find-nested-obj.ts",[],{"ruleId":"345","replacedBy":"346"},{"ruleId":"347","replacedBy":"348"},{"ruleId":"345","replacedBy":"349"},{"ruleId":"347","replacedBy":"350"},{"ruleId":"345","replacedBy":"351"},{"ruleId":"347","replacedBy":"352"},{"ruleId":"345","replacedBy":"353"},{"ruleId":"347","replacedBy":"354"},{"rul