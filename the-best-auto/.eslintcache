he-best-auto/src/features/catalog/slice.ts",[],["174","175"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/routes.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/product/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/catalog/index.tsx",["176"],"import React from 'react'\nimport { useParams } from 'react-router-dom'\nimport TuneIcon from '@material-ui/icons/Tune'\nimport CloseIcon from '@material-ui/icons/Close'\nimport Typography from '@material-ui/core/Typography'\nimport CheckIcon from '@material-ui/icons/Check'\nimport Grid from '@material-ui/core/Grid'\nimport { CategoryItem } from 'features/catalog/features/categories/molecules'\nimport { CatalogCard } from 'features/catalog/molecules'\nimport { FilterItems } from 'features/catalog/features/filter/organisms'\nimport { useAppDispatch, useTypedSelector } from 'configureStore'\nimport { getCategories, setInitializeCategories } from 'features/catalog/slice'\nimport { CatalogTemplate } from 'features/catalog/templates'\n\nexport const CatalogPage = () => {\n  const dispatch = useAppDispatch()\n  const initializeCategories = useTypedSelector(state => state.catalog.categories.initialized)\n  if (!initializeCategories) {\n    Promise.all([dispatch(getCategories())]).then(() => {\n      dispatch(setInitializeCategories(true))\n    })\n  }\n  const selectedCategory = useTypedSelector(state => state.catalog.selectedCategory)\n  const categoriesData = useTypedSelector(state => state.catalog.categories.categoriesData)\n\n  interface ParamTypes {\n    categoryLink: string\n  }\n\n  const { categoryLink } = useParams<ParamTypes>()\n  console.log(categoryLink)\n\n  const categoryItems = categoriesData.map(item => {\n    return <CategoryItem link={item.link} name={item.name} currentLink={categoryLink} />\n  })\n\n  const cardsData = [\n    {\n      carName: 'VOLKSWAGEN CC SPORT',\n      src: 'https://the-best-auto.com/assets/catalog/990/6.jpg',\n      runCount: 40,\n      price: 9400,\n      newPrice: 9000,\n      year: 2015,\n    },\n    {\n      carName: 'VOLKSWAGEN CC SPORT',\n      src: 'https://the-best-auto.com/assets/catalog/990/6.jpg',\n      runCount: 40,\n      price: 9400,\n      year: 2015,\n    },\n    {\n      carName: 'VOLKSWAGEN CC SPORT',\n      src: 'https://the-best-auto.com/assets/catalog/990/6.jpg',\n      runCount: 40,\n      price: 9400,\n      year: 2015,\n    },\n    {\n      carName: 'VOLKSWAGEN CC SPORT',\n      src: 'https://the-best-auto.com/assets/catalog/990/6.jpg',\n      runCount: 40,\n      price: 9400,\n      year: 2015,\n    },\n  ]\n\n  const cards = cardsData.map(item => {\n    return (\n      <CatalogCard\n        carName={item.carName}\n        src={item.src}\n        runCount={item.runCount}\n        price={item.price}\n        newPrice={item.newPrice}\n        year={item.year}\n      />\n    )\n  })\n  return (\n    <>\n      {!categoryLink && (\n        <>\n          <Typography variant='h4' align='center'>\n            Виберiть категорiю\n          </Typography>\n          <Grid container spacing={2} justify='center'>\n            {categoryItems.map(item => {\n              return <Grid item>{item}</Grid>\n            })}\n          </Grid>\n        </>\n      )}\n      {categoryLink && (\n        <CatalogTemplate\n          filter={<FilterItems />}\n          settingButton={<TuneIcon />}\n          cards={cards}\n          closeIcon={<CloseIcon />}\n          filterTitle={<Typography variant='h6'>Фільтри</Typography>}\n          checkButton={<CheckIcon />}\n          categoryItems={categoryItems}\n        />\n      )}\n    </>\n  )\n}\n",["177","178"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/atoms/index.ts",[],["179","180"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/title-with-icon/index.tsx",[],["181","182"],"/home/taras/dev/the-best-auto/the-best-auto/src/features/services/molecules/services-card/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/instagram/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/App.tsx",["183"],"import CssBaseline from '@material-ui/core/CssBaseline'\nimport { ThemeProvider } from '@material-ui/core/styles'\nimport { theme } from './theme'\nimport { Header, Footer } from './shared/organisms'\nimport { Pages } from 'pages'\nimport Container from '@material-ui/core/Container'\nimport Box from '@material-ui/core/Box'\nimport { useMediaQuery } from '@material-ui/core'\nfunction App() {\n  const matches = useMediaQuery(theme.breakpoints.up('md'))\n  return (\n    <>\n      <CssBaseline />\n      <ThemeProvider theme={theme}>\n        <Header />\n        <Container>\n          <Box marginTop={matches ? 15 : 10}>\n            <Pages />\n          </Box>\n        </Container>\n        {/* <Footer /> */}\n      </ThemeProvider>\n    </>\n  )\n}\n\nexport default App\n","/home/taras/dev/the-best-auto/the-best-auto/src/shared/organisms/header/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/contacts/index.tsx",[],["184","185"],"/home/taras/dev/the-best-auto/the-best-auto/src/pages/search/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/index.ts",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/organisms/social/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/shared/molecules/skeleton-loader/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/catalog/features/filter/organisms/filter-items/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/features/social-media/molecules/youtube/index.tsx",[],"/home/taras/dev/the-best-auto/the-best-auto/src/index.ts